{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://compulsa-obra-backend.onrender.com/api/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "https://compulsa-obra-backend.onrender.com/health"
    },
    {
      "source": "/((?!assets/|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ]
}
