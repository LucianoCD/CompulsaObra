              <span>Subtotal Materiales:</span>
              <span className="tabular-nums font-semibold text-slate-200">
                $ {split.total_materials_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
              </span>
            </div>
            <div className="flex justify-between text-slate-400">
              <span>Suma de Fletes ({split.participating_vendors_count} envíos):</span>
              <span className="tabular-nums font-semibold text-amber-400">
                + $ {split.total_delivery_fees_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
              </span>
            </div>
            <div className="flex justify-between text-slate-200 font-bold pt-1 border-t border-slate-800">
              <span>Total Carrito Dividido:</span>
              <span className="text-lg font-black text-emerald-400 tabular-nums">
                $ {split.total_cart_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
              </span>
            </div>
          </div>

          {split.savings_vs_single_vendor_ars > 0 && (
            <div className="mt-3 p-2.5 rounded-lg bg-emerald-500/20 border border-emerald-500/40 text-emerald-300 text-xs font-semibold flex items-center justify-between">
              <span>¡Ahorro Real de Bolsillo descontando fletes:</span>
              <span className="font-mono text-sm font-black tabular-nums">
                $ {split.savings_vs_single_vendor_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
              </span>
            </div>
          )}
        </div>
      </div>

      {/* Acciones de Congelamiento e Inmutabilidad */}
      <div className="pt-3 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div className="text-xs text-slate-400 flex items-center gap-1.5">
          <Lock className="w-4 h-4 text-slate-500" />
          <span>
            Congelar el presupuesto sella una instantánea inmutable (`snapshot_json`) y emite el enlace firmado.
          </span>
        </div>

        <div className="flex items-center gap-2">
          {!lockedBudget ? (
            <button
              onClick={handleLock}
              disabled={isLoading}
              className="flex items-center gap-2 px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs shadow-md transition"
            >
              <Lock className="w-3.5 h-3.5" />
              <span>Congelar Presupuesto (Lock-Budget)</span>
            </button>
          ) : (
            <div className="flex items-center gap-2">
              <a
                href={apiClient.getPdfUrl(currentMatrix.run_id, 'comparison')}
                target="_blank"
                rel="noreferrer"
                className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-medium transition"
              >
                <Download className="w-3.5 h-3.5 text-emerald-400" />
                <span>PDF Comparativa</span>
              </a>
              <a
                href={apiClient.getPdfUrl(currentMatrix.run_id, 'client_budget')}
                target="_blank"
                rel="noreferrer"
                className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-medium transition shadow"
              >
                <FileText className="w-3.5 h-3.5" />
                <span>PDF Presupuesto Cliente</span>
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/components/VendorCatalogModal.tsx">
import React, { useState } from 'react';
import { useComparisonStore } from '../store/useComparisonStore';
import { apiClient } from '../services/apiClient';
import { CatalogImportSummary, ColumnMapping } from '../types/api';
import { Store, Upload, Download, CheckCircle2, X, Plus, Clock } from 'lucide-react';

interface VendorCatalogModalProps {
  isOpen: boolean;
  onClose: () => void;
}

export const VendorCatalogModal: React.FC<VendorCatalogModalProps> = ({ isOpen, onClose }) => {
  const { vendors, loadVendors } = useComparisonStore();

  const [activeTab, setActiveTab] = useState<'import' | 'new_vendor'>('import');
  const [selectedVendorId, setSelectedVendorId] = useState<string>(vendors[0]?.id || '');
  const [file, setFile] = useState<File | null>(null);
  const [mapping, setMapping] = useState<ColumnMapping>({
    sku_col: 'sku',
    desc_col: 'descripcion',
    price_cash_col: 'precio_contado',
    price_list_col: 'precio_lista',
    unit_col: 'unidad',
    brand_col: 'marca',
    category_col: 'categoria',
  });

  const [importSummary, setImportSummary] = useState<CatalogImportSummary | null>(null);
  const [isUploading, setIsUploading] = useState(false);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);

  // Formulario nuevo comercio
  const [newName, setNewName] = useState('');
  const [newLocality, setNewLocality] = useState('San Salvador de Jujuy');
  const [newPhone, setNewPhone] = useState('');
  const [newDiscount, setNewDiscount] = useState('5');
  const [newDelivery, setNewDelivery] = useState('15000');
  const [acopioEnabled, setAcopioEnabled] = useState(true);
  const [acopioDownPayment, setAcopioDownPayment] = useState('80');
  const [acopioFreezeDays, setAcopioFreezeDays] = useState('45');

  if (!isOpen) return null;

  const handleImport = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!file || !selectedVendorId) return;

    try {
      setIsUploading(true);
      setErrorMessage(null);
      const summary = await apiClient.importCatalog(selectedVendorId, file, JSON.stringify(mapping));
      setImportSummary(summary);
      await loadVendors();
      setIsUploading(false);
    } catch (err: unknown) {
      setIsUploading(false);
      setErrorMessage(err instanceof Error ? err.message : 'Error al importar catálogo');
    }
  };

  const handleCreateVendor = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newName.trim()) return;

    try {
      setIsUploading(true);
      setErrorMessage(null);
      const created = await apiClient.createVendor({
        name: newName,
        locality: newLocality,
        whatsapp_phone: newPhone || null,
        cash_discount_pct: parseFloat(newDiscount) || 0,
        estimate_delivery_fee_ars: parseFloat(newDelivery) || 0,
        acopio_config: {
          enabled: acopioEnabled,
          min_down_payment_pct: parseFloat(acopioDownPayment) || 100,
          freeze_days: parseInt(acopioFreezeDays, 10) || 30,
          max_withdrawal_days: 90,
          min_notice_hours: 24,
        },
      });
      await loadVendors();
      setSelectedVendorId(created.id);
      setActiveTab('import');
      setIsUploading(false);
    } catch (err: unknown) {
      setIsUploading(false);
      setErrorMessage(err instanceof Error ? err.message : 'Error al registrar comercio');
    }
  };

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4">
      <div className="bg-slate-900 border border-slate-800 rounded-xl w-full max-w-2xl shadow-2xl overflow-hidden flex flex-col max-h-[90vh]">
        {/* Cabecera */}
        <div className="flex items-center justify-between p-4 border-b border-slate-800">
          <div className="flex items-center gap-2">
            <Store className="w-5 h-5 text-emerald-400" />
            <h3 className="font-semibold text-slate-100 text-sm">
              Gestor de Corralones, Listas de Precios y Acopio
            </h3>
          </div>
          <button onClick={onClose} className="p-1 rounded hover:bg-slate-800 text-slate-400 hover:text-slate-200">
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* Pestañas */}
        <div className="flex border-b border-slate-800 bg-slate-950 px-4">
          <button
            onClick={() => setActiveTab('import')}
            className={`py-2.5 px-4 text-xs font-medium border-b-2 transition ${
              activeTab === 'import'
                ? 'border-emerald-500 text-emerald-400'
                : 'border-transparent text-slate-400 hover:text-slate-200'
            }`}
          >
            Importar Lista de Precios (.xlsx / .csv)
          </button>
          <button
            onClick={() => setActiveTab('new_vendor')}
            className={`py-2.5 px-4 text-xs font-medium border-b-2 transition ${
              activeTab === 'new_vendor'
                ? 'border-emerald-500 text-emerald-400'
                : 'border-transparent text-slate-400 hover:text-slate-200'
            }`}
          >
            + Registrar Nuevo Corralón
          </button>
        </div>

        {/* Cuerpo */}
        <div className="p-5 overflow-y-auto space-y-4">
          {errorMessage && (
            <div className="p-3 bg-red-500/10 border border-red-500/30 rounded-lg text-xs text-red-300">
              {errorMessage}
            </div>
          )}

          {activeTab === 'import' && (
            <form onSubmit={handleImport} className="space-y-4">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label className="block text-xs font-medium text-slate-300 mb-1">
                    Comercio a Actualizar:
                  </label>
                  <select
                    value={selectedVendorId}
                    onChange={(e) => setSelectedVendorId(e.target.value)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-slate-200 focus:outline-none focus:border-emerald-500"
                  >
                    {vendors.map((v) => (
                      <option key={v.id} value={v.id}>
                        {v.name} ({v.locality})
                      </option>
                    ))}
                  </select>
                </div>

                <div>
                  <label className="block text-xs font-medium text-slate-300 mb-1">
                    Plantilla CSV de Demostración:
                  </label>
                  <a
                    href={apiClient.getSampleTemplateUrl()}
                    download="plantilla_materiales_ejemplo.csv"
                    className="flex items-center justify-center gap-1.5 w-full bg-slate-950 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 text-slate-300 rounded-lg p-2 text-xs font-medium transition"
                  >
                    <Download className="w-3.5 h-3.5 text-emerald-400" />
                    <span>Descargar Plantilla en 1 Clic</span>
                  </a>
                </div>
              </div>

              {/* Subida de archivo */}
              <div>
                <label className="block text-xs font-medium text-slate-300 mb-1">
                  Archivo de Lista de Precios (.xlsx, .xls o .csv):
                </label>
                <input
                  type="file"
                  accept=".csv,.xlsx,.xls"
                  onChange={(e) => setFile(e.target.files?.[0] || null)}
                  className="w-full text-xs text-slate-400 file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-emerald-500/10 file:text-emerald-400 hover:file:bg-emerald-500/20 cursor-pointer"
                />
              </div>

              {/* Mapeador de columnas */}
              <div className="bg-slate-950 p-3 rounded-lg border border-slate-800/80 space-y-2">
                <span className="text-[11px] font-semibold text-slate-300 uppercase tracking-wide">
                  Mapeo de Columnas de la Planilla
                </span>
                <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
                  <div>
                    <label className="text-[10px] text-slate-500">Columna SKU</label>
                    <input
                      type="text"
                      value={mapping.sku_col}
                      onChange={(e) => setMapping({ ...mapping, sku_col: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-800 rounded px-2 py-1 text-slate-200 text-xs"
                    />
                  </div>
                  <div>
                    <label className="text-[10px] text-slate-500">Columna Descripción</label>
                    <input
                      type="text"
                      value={mapping.desc_col}
                      onChange={(e) => setMapping({ ...mapping, desc_col: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-800 rounded px-2 py-1 text-slate-200 text-xs"
                    />
                  </div>
                  <div>
                    <label className="text-[10px] text-slate-500">Columna Precio Contado</label>
                    <input
                      type="text"
                      value={mapping.price_cash_col}
                      onChange={(e) => setMapping({ ...mapping, price_cash_col: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-800 rounded px-2 py-1 text-slate-200 text-xs"
                    />
                  </div>
                  <div>
                    <label className="text-[10px] text-slate-500">Columna Precio Lista</label>
                    <input
                      type="text"
                      value={mapping.price_list_col || ''}
                      onChange={(e) => setMapping({ ...mapping, price_list_col: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-800 rounded px-2 py-1 text-slate-200 text-xs"
                    />
                  </div>
                </div>
              </div>

              {/* Resumen de Deduplicación SHA-256 */}
              {importSummary && (
                <div className="p-3 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-xs text-emerald-300 space-y-1">
                  <div className="flex items-center gap-1.5 font-semibold">
                    <CheckCircle2 className="w-4 h-4 text-emerald-400" />
                    ¡Catálogo Versión {importSummary.version_number} Importado con Éxito!
                  </div>
                  <div className="grid grid-cols-3 gap-2 pt-1 text-[11px] font-mono">
                    <div>Total Filas: {importSummary.total_rows}</div>
                    <div className="text-amber-300">Nuevas/Modificadas: {importSummary.new_or_updated_rows}</div>
                    <div className="text-emerald-400">Reutilizadas SHA-256: {importSummary.unchanged_skipped_rows}</div>
                  </div>
                </div>
              )}

              <div className="flex justify-end gap-2 pt-2">
                <button
                  type="submit"
                  disabled={isUploading || !file}
                  className="flex items-center gap-1.5 px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-xs shadow transition disabled:opacity-50"
                >
                  <Upload className="w-3.5 h-3.5" />
                  <span>{isUploading ? 'Procesando Hash SHA-256...' : 'Importar Lista'}</span>
                </button>
              </div>
            </form>
          )}

          {activeTab === 'new_vendor' && (
            <form onSubmit={handleCreateVendor} className="space-y-3">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-medium text-slate-300 mb-1">Nombre del Comercio</label>
                  <input
                    type="text"
                    required
                    value={newName}
                    onChange={(e) => setNewName(e.target.value)}
                    placeholder="Ej. Corralón Norte Jujuy"
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-slate-200"
                  />
                </div>
                <div>
                  <label className="block text-xs font-medium text-slate-300 mb-1">Localidad</label>
                  <input
                    type="text"
                    required
                    value={newLocality}
                    onChange={(e) => setNewLocality(e.target.value)}
                    placeholder="San Salvador de Jujuy / Palpalá / Perico"
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-slate-200"
                  />
                </div>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                  <label className="block text-xs font-medium text-slate-300 mb-1">Teléfono WhatsApp</label>
                  <input
                    type="text"
                    value={newPhone}
                    onChange={(e) => setNewPhone(e.target.value)}
                    placeholder="+543884..."
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-slate-200"
                  />
                </div>
                <div>
                  <label className="block text-xs font-medium text-slate-300 mb-1">Desc. Contado (%)</label>
                  <input
                    type="number"
                    value={newDiscount}
                    onChange={(e) => setNewDiscount(e.target.value)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-slate-200"
                  />
                </div>
                <div>
                  <label className="block text-xs font-medium text-slate-300 mb-1">Flete Base (ARS)</label>
                  <input
                    type="number"
                    value={newDelivery}
                    onChange={(e) => setNewDelivery(e.target.value)}
                    className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-xs text-slate-200"
                  />
                </div>
              </div>

              {/* Configuración de Acopio */}
              <div className="p-3 bg-slate-950 rounded-lg border border-slate-800 space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-semibold text-slate-300 flex items-center gap-1.5">
                    <Clock className="w-3.5 h-3.5 text-emerald-400" />
                    Reglas de Acopio de Materiales
                  </span>
                  <label className="flex items-center gap-1.5 text-xs text-slate-400 cursor-pointer">
                    <input
                      type="checkbox"
                      checked={acopioEnabled}
                      onChange={(e) => setAcopioEnabled(e.target.checked)}
                      className="rounded bg-slate-800 text-emerald-500"
                    />
                    Habilitar Acopio
                  </label>
                </div>

                {acopioEnabled && (
                  <div className="grid grid-cols-2 gap-3 text-xs pt-1">
                    <div>
                      <label className="text-[10px] text-slate-500">% Anticipo Requerido</label>
                      <input
                        type="number"
                        value={acopioDownPayment}
                        onChange={(e) => setAcopioDownPayment(e.target.value)}
                        className="w-full bg-slate-900 border border-slate-800 rounded p-1.5 text-slate-200"
                      />
                    </div>
                    <div>
                      <label className="text-[10px] text-slate-500">Días Congelamiento de Precio</label>
                      <input
                        type="number"
                        value={acopioFreezeDays}
                        onChange={(e) => setAcopioFreezeDays(e.target.value)}
                        className="w-full bg-slate-900 border border-slate-800 rounded p-1.5 text-slate-200"
                      />
                    </div>
                  </div>
                )}
              </div>

              <div className="flex justify-end pt-2">
                <button
                  type="submit"
                  disabled={isUploading}
                  className="flex items-center gap-1.5 px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-medium text-xs shadow transition"
                >
                  <Plus className="w-3.5 h-3.5" />
                  <span>Guardar Comercio</span>
                </button>
              </div>
            </form>
          )}
        </div>
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/pages/BuilderDashboardPage.tsx">
import React, { useEffect, useState } from 'react';
import { useWorkspaceStore } from '../store/useWorkspaceStore';
import { useRequisitionStore } from '../store/useRequisitionStore';
import { useComparisonStore } from '../store/useComparisonStore';
import { IngestionDropzone } from '../components/IngestionDropzone';
import { DisambiguationTable } from '../components/DisambiguationTable';
import { MultiVendorMatrix } from '../components/MultiVendorMatrix';
import { SplitCartOptimizerCard } from '../components/SplitCartOptimizerCard';
import { AcopioSimulatorPanel } from '../components/AcopioSimulatorPanel';
import { VendorCatalogModal } from '../components/VendorCatalogModal';
import { Store, Sliders, RefreshCw, DollarSign, Truck } from 'lucide-react';
import { PaymentModality } from '../types/api';

export const BuilderDashboardPage: React.FC = () => {
  const { role } = useWorkspaceStore();
  const { currentRequisition, resetRequisition } = useRequisitionStore();
  const {
    vendors,
    selectedVendorIds,
    paymentModality,
    markupPct,
    includeDeliveryFees,
    currentMatrix,
    loadVendors,
    toggleVendorSelection,
    setPaymentModality,
    setMarkupPct,
    setIncludeDeliveryFees,
    resetComparison,
  } = useComparisonStore();

  const [isCatalogModalOpen, setIsCatalogModalOpen] = useState(false);

  useEffect(() => {
    loadVendors();
  }, [loadVendors]);

  const handleNewBudget = () => {
    resetRequisition();
    resetComparison();
  };

  return (
    <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
      {/* Barra de Acciones Globales del Presupuestador */}
      <div className="bg-slate-900 border border-slate-800 rounded-xl p-4 flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div className="flex items-center gap-3">
          <div className="p-2.5 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            <Sliders className="w-5 h-5" />
          </div>
          <div>
            <h1 className="text-base font-bold text-slate-100">
              Panel de Elaboración y Compulsa de Materiales
            </h1>
            <p className="text-xs text-slate-400">
              {role === 'ESTIMATOR'
                ? 'Perfil Presupuestador Profesional: Margen de honorarios y presupuesto consolidado activo.'
                : 'Perfil Comprador Final: Enfoque en ahorro directo de bolsillo y mejores precios de corralón.'}
            </p>
          </div>
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <button
            onClick={() => setIsCatalogModalOpen(true)}
            className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-medium transition"
          >
            <Store className="w-3.5 h-3.5 text-emerald-400" />
            <span>Gestionar Corralones ({vendors.length})</span>
          </button>

          {currentRequisition && (
            <button
              onClick={handleNewBudget}
              className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 text-xs font-medium transition"
            >
              <RefreshCw className="w-3.5 h-3.5" />
              <span>Nuevo Pedido</span>
            </button>
          )}
        </div>
      </div>

      {/* Selector de Comercios a Comparar y Parámetros */}
      <div className="bg-slate-900 border border-slate-800 rounded-xl p-4 space-y-3">
        <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
          <span className="text-xs font-semibold text-slate-300 uppercase tracking-wide">
            Comercios Activos para la Compulsa:
          </span>
          <div className="flex flex-wrap items-center gap-3 text-xs">
            {/* Modalidad de pago */}
            <div className="flex items-center gap-1 bg-slate-950 p-1 rounded-lg border border-slate-800">
              {(['CASH', 'LIST', 'ACOPIO'] as PaymentModality[]).map((mod) => (
                <button
                  key={mod}
                  onClick={() => setPaymentModality(mod)}
                  className={`px-2 py-0.5 rounded text-[11px] font-semibold transition ${
                    paymentModality === mod
                      ? 'bg-slate-800 text-emerald-400 shadow'
                      : 'text-slate-400 hover:text-slate-200'
                  }`}
                >
                  {mod === 'CASH' ? 'Contado' : mod === 'LIST' ? 'Precio Lista' : 'Acopio'}
                </button>
              ))}
            </div>

            {/* Toggle de Fletes */}
            <label className="flex items-center gap-1.5 text-slate-300 cursor-pointer">
              <input
                type="checkbox"
                checked={includeDeliveryFees}
                onChange={(e) => setIncludeDeliveryFees(e.target.checked)}
                className="rounded bg-slate-800 text-emerald-500"
              />
              <Truck className="w-3.5 h-3.5 text-slate-400" />
              <span>Incluir Fletes</span>
            </label>

            {/* Margen del presupuestador (solo si ESTIMATOR) */}
            {role === 'ESTIMATOR' && (
              <div className="flex items-center gap-1.5 bg-slate-950 px-2.5 py-1 rounded-lg border border-slate-800">
                <DollarSign className="w-3.5 h-3.5 text-emerald-400" />
                <span className="text-slate-400">Margen:</span>
                <input
