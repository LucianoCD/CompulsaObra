import React from 'react';
import { useWorkspaceStore } from '../store/useWorkspaceStore';
import { AlertTriangle, Briefcase, ShoppingCart, Sparkles, Building2 } from 'lucide-react';

export const DemoBanner: React.FC = () => {
  const { isDemo, role, workspaceName, switchMode, setRole } = useWorkspaceStore();

  return (
    <header className="border-b border-slate-800 bg-slate-900/90 backdrop-blur sticky top-0 z-40">
      {/* Cintillo Prominente de Modo Demo */}
      {isDemo && (
        <div className="bg-amber-500/10 border-b border-amber-500/30 px-4 py-1.5 flex items-center justify-between text-xs text-amber-300">
          <div className="flex items-center gap-2 font-medium tracking-wide">
            <AlertTriangle className="w-4 h-4 text-amber-400 shrink-0" />
            <span className="font-semibold uppercase">[MODO DEMO DATOS COMERCIALES ILUSTRATIVOS]</span>
            <span className="hidden sm:inline text-amber-200/80">
              — 3 corralones semilla cargados (El Pórtico, Cuyaya, Sanitarios Palpalá).
            </span>
          </div>
          <button
            onClick={() => switchMode(false)}
            className="flex items-center gap-1.5 px-2.5 py-0.5 rounded bg-amber-500/20 hover:bg-amber-500/30 text-amber-200 border border-amber-500/40 font-medium transition"
          >
            <Sparkles className="w-3.5 h-3.5" />
            Cambiar a Cuenta Real (/traccion)
          </button>
        </div>
      )}

      {/* Barra de Navegación Principal y Selector de Rol */}
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <div className="h-9 w-9 rounded-lg bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 font-black text-lg">
            CO
          </div>
          <div>
            <div className="flex items-center gap-2">
              <span className="font-bold text-slate-100 tracking-tight text-base sm:text-lg">CompulsaObra</span>
              <span className="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">
                NOA v0.1
              </span>
            </div>
            <p className="text-xs text-slate-400 hidden sm:block">
              {workspaceName} {isDemo ? '(Demostración)' : '(Real)'}
            </p>
          </div>
        </div>

        {/* Controles de Perfil y Enlaces */}
        <div className="flex items-center gap-3 sm:gap-4">
          <a
            href="/traccion"
            className="text-xs text-slate-400 hover:text-emerald-400 font-medium transition flex items-center gap-1"
          >
            <Building2 className="w-3.5 h-3.5" />
            <span className="hidden sm:inline">Métricas</span> /traccion
          </a>

          {/* Selector de Rol BUYER vs ESTIMATOR */}
          <div className="flex items-center bg-slate-950 p-1 rounded-lg border border-slate-800">
            <button
              onClick={() => setRole('ESTIMATOR')}
              className={`flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium transition ${
                role === 'ESTIMATOR'
                  ? 'bg-emerald-600 text-white shadow-sm'
                  : 'text-slate-400 hover:text-slate-200'
              }`}
            >
              <Briefcase className="w-3.5 h-3.5" />
              <span>Presupuestador</span>
            </button>
            <button
              onClick={() => setRole('BUYER')}
              className={`flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium transition ${
                role === 'BUYER'
                  ? 'bg-emerald-600 text-white shadow-sm'
                  : 'text-slate-400 hover:text-slate-200'
              }`}
            >
              <ShoppingCart className="w-3.5 h-3.5" />
              <span>Comprador</span>
            </button>
          </div>

          {!isDemo && (
            <button
              onClick={() => switchMode(true)}
              className="text-xs px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 transition"
            >
              Volver a Demo
            </button>
          )}
        </div>
      </div>
    </header>
  );
};
</file>

<file path="frontend/src/components/DisambiguationTable.tsx">
import React, { useState } from 'react';
import { useRequisitionStore } from '../store/useRequisitionStore';
import { useComparisonStore } from '../store/useComparisonStore';
import { CheckCircle2, AlertTriangle, ShieldCheck, ArrowRight, Save, Layers } from 'lucide-react';
import { RequisitionItemResponse } from '../types/api';

interface DisambiguationTableProps {
  onProceedToCompare: () => void;
}

export const DisambiguationTable: React.FC<DisambiguationTableProps> = ({ onProceedToCompare }) => {
  const { currentRequisition, resolveItem, isLoading } = useRequisitionStore();
  const { runComparison } = useComparisonStore();

  const [saveAsAliasMap, setSaveAsAliasMap] = useState<Record<string, boolean>>({});

  if (!currentRequisition) return null;

  const items = currentRequisition.items;
  const pendingCount = currentRequisition.pending_clarifications_count;
  const allResolved = pendingCount === 0;

  const handleQuickResolve = (item: RequisitionItemResponse, material: string) => {
    const saveAlias = !!saveAsAliasMap[item.id];
    const confirmedTerm = `${item.requested_term} ${material}`.trim();

    resolveItem(item.id, {
      material_type: material,
      confirmed_term: confirmedTerm,
      save_as_alias: saveAlias,
    });
  };

  const handleStartComparison = async () => {
    if (!allResolved) return;
    await runComparison(currentRequisition.id);
    onProceedToCompare();
  };

  return (
    <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg space-y-4">
      <div className="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-800 gap-2">
        <div>
          <h2 className="text-base font-semibold text-slate-100 flex items-center gap-2">
            <ShieldCheck className="w-4 h-4 text-emerald-400" />
            Paso 2: Consola Human-in-the-Loop y Desambiguación Dimensional
          </h2>
          <p className="text-xs text-slate-400">
            Valida las dimensiones físicas antes de comparar precios. Cero sustitución ciega.
          </p>
        </div>

        {/* Indicador de estado */}
        <div className="flex items-center gap-2">
          {allResolved ? (
            <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
              <CheckCircle2 className="w-3.5 h-3.5" />
              Pliego Listo para Compulsa ({items.length} ítems confirmados)
            </span>
          ) : (
            <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/30 animate-pulse">
              <AlertTriangle className="w-3.5 h-3.5" />
              {pendingCount} ítem{pendingCount > 1 ? 's' : ''} requiere{pendingCount > 1 ? 'n' : ''} aclaración
            </span>
          )}
        </div>
      </div>

      {/* Tabla de ítems con semáforo */}
      <div className="overflow-x-auto">
        <table className="w-full text-left text-xs">
          <thead>
            <tr className="border-b border-slate-800 text-slate-400 uppercase tracking-wider text-[11px]">
              <th className="py-2.5 px-3">#</th>
              <th className="py-2.5 px-3">Entrada Original</th>
              <th className="py-2.5 px-3">Cantidad</th>
              <th className="py-2.5 px-3">Diámetro / Peso</th>
              <th className="py-2.5 px-3">Material / Tipo</th>
              <th className="py-2.5 px-3">Estado Dimensional</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-800/60 font-mono">
            {items.map((item) => {
              const isPending = item.completeness === 'missing_critical_attribute';

              return (
                <React.Fragment key={item.id}>
                  <tr className={`transition ${isPending ? 'bg-amber-500/5' : 'hover:bg-slate-800/30'}`}>
                    <td className="py-2.5 px-3 text-slate-500 font-sans">{item.line_order}</td>
                    <td className="py-2.5 px-3 font-medium text-slate-200 font-sans">
                      {item.raw_line}
                    </td>
                    <td className="py-2.5 px-3 tabular-nums">
                      {item.quantity} {item.requested_unit}
                    </td>
                    <td className="py-2.5 px-3 tabular-nums">
                      {item.diameter_mm ? `Ø ${item.diameter_mm} mm` : ''}
                      {item.diameter_inch ? ` (${item.diameter_inch}")` : ''}
                      {item.weight_kg ? `${item.weight_kg} kg` : ''}
                      {!item.diameter_mm && !item.weight_kg ? '-' : ''}
                    </td>
                    <td className="py-2.5 px-3 font-sans">
                      {item.material_type ? (
                        <span className="px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700 text-[11px]">
                          {item.material_type}
                        </span>
                      ) : (
                        <span className="text-amber-400 font-semibold text-[11px] flex items-center gap-1">
                          <AlertTriangle className="w-3 h-3" />
                          Falta Especificar
                        </span>
                      )}
                    </td>
                    <td className="py-2.5 px-3 font-sans">
                      {isPending ? (
                        <span className="px-2 py-0.5 rounded bg-amber-500/20 text-amber-300 font-medium text-[11px] border border-amber-500/40">
                          Requiere Acción
                        </span>
                      ) : (
                        <span className="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 font-medium text-[11px] border border-emerald-500/20">
                          Confirmado
                        </span>
                      )}
                    </td>
                  </tr>

                  {/* Fila desplegada para resolución interactiva HITL */}
                  {isPending && (
                    <tr className="bg-amber-500/10 border-b border-amber-500/30">
                      <td colSpan={6} className="py-3 px-4 font-sans">
                        <div className="flex flex-col md:flex-row md:items-center justify-between gap-3">
                          <div>
                            <p className="text-xs text-amber-200 font-medium flex items-center gap-1.5">
                              <Layers className="w-4 h-4 text-amber-400 shrink-0" />
                              {item.clarification_prompt || 'Especifique el material para garantizar compatibilidad:'}
                            </p>
                            <label className="flex items-center gap-1.5 text-[11px] text-slate-400 mt-2 cursor-pointer">
                              <input
                                type="checkbox"
                                checked={!!saveAsAliasMap[item.id]}
                                onChange={(e) =>
                                  setSaveAsAliasMap({ ...saveAsAliasMap, [item.id]: e.target.checked })
                                }
                                className="rounded bg-slate-800 border-slate-700 text-emerald-500 focus:ring-emerald-500 w-3.5 h-3.5"
                              />
                              <Save className="w-3 h-3 text-slate-400" />
                              Guardar mi preferencia como equivalencia supervisada para futuros presupuestos
                            </label>
                          </div>

                          {/* Botones de acción rápida por rubro */}
                          <div className="flex flex-wrap items-center gap-2">
                            {['PVC Cloacal/Agua', 'Termofusión', 'Polipropileno', 'Corrugado'].map((mat) => (
                              <button
                                key={mat}
                                onClick={() => handleQuickResolve(item, mat)}
                                disabled={isLoading}
                                className="px-3 py-1.5 rounded-lg bg-slate-900 hover:bg-emerald-600 border border-slate-700 hover:border-emerald-500 text-xs text-slate-200 hover:text-white font-medium transition shadow-sm"
                              >
                                {mat}
                              </button>
                            ))}
                          </div>
                        </div>
                      </td>
                    </tr>
                  )}
                </React.Fragment>
              );
            })}
          </tbody>
        </table>
      </div>

      {/* Botón de acción para avanzar a la compulsa */}
      <div className="pt-3 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3">
        <p className="text-xs text-slate-400">
          {allResolved
            ? 'Todos los ítems están estandarizados físicamente. Listo para cotizar contra los corralones.'
            : 'El sistema bloquea la compulsa para evitar cotizar caños o materiales incorrectos.'}
        </p>

        <button
          onClick={handleStartComparison}
          disabled={!allResolved || isLoading}
          className={`flex items-center gap-2 px-5 py-2.5 rounded-lg font-semibold text-xs shadow-md transition ${
            allResolved
              ? 'bg-emerald-600 hover:bg-emerald-500 text-white cursor-pointer'
              : 'bg-slate-800 text-slate-500 cursor-not-allowed border border-slate-700'
          }`}
        >
          <span>Ejecutar Compulsa Multi-Negocio</span>
          <ArrowRight className="w-4 h-4" />
        </button>
      </div>
    </div>
  );
};
</file>

