                <ArrowRight className="w-3 h-3 ml-0.5" />
              </button>
            )}
          </div>
        </div>
      </aside>

      {/* Modal de Autenticación / Registro */}
      <AuthModal isOpen={isAuthOpen} onClose={() => setIsAuthOpen(false)} />
    </>
  );
};
</file>

