<file path="frontend/src/components/VendorCatalogModal.tsx">
import React, { useEffect, useRef, useState } from 'react';
import { useComparisonStore } from '../store/useComparisonStore';
import { apiClient } from '../services/apiClient';
import { CatalogImportSummary, ColumnMapping } from '../types/api';
import {
  Store,
  Upload,
  Download,
  CheckCircle2,
  X,
  Plus,
  Clock,
  AlertTriangle,
  Loader2,
} from 'lucide-react';

interface VendorCatalogModalProps {
  isOpen: boolean;
  onClose: () => void;
}

export const VendorCatalogModal: React.FC<VendorCatalogModalProps> = ({ isOpen, onClose }) => {
  const { vendors, loadVendors } = useComparisonStore();

  const [activeTab, setActiveTab] = useState<'import' | 'new_vendor'>('import');
  const [selectedVendorId, setSelectedVendorId] = useState<string>(vendors[0]?.id || '');
  const [file, setFile] = useState<File | null>(null);
  const [mapping, setMapping] = useState<ColumnMapping>({
    sku_col: 'sku',
    desc_col: 'descripcion',
    price_cash_col: 'precio_contado',
    price_list_col: 'precio_lista',
    unit_col: 'unidad',
    brand_col: 'marca',
    category_col: 'categoria',
  });

  const [importSummary, setImportSummary] = useState<CatalogImportSummary | null>(null);
  const [isUploading, setIsUploading] = useState(false);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);

  // Formulario nuevo corralón
  const [newName, setNewName] = useState('');
  const [newLocality, setNewLocality] = useState('San Salvador de Jujuy');
  const [newPhone, setNewPhone] = useState('');
  const [newDiscount, setNewDiscount] = useState('5');
  const [newDelivery, setNewDelivery] = useState('15000');
  const [acopioEnabled, setAcopioEnabled] = useState(true);
  const [acopioDownPayment, setAcopioDownPayment] = useState('80');
  const [acopioFreezeDays, setAcopioFreezeDays] = useState('45');

  const dialogRef = useRef<HTMLDialogElement | null>(null);

  useEffect(() => {
    if (isOpen && dialogRef.current) {
      if (!dialogRef.current.open) dialogRef.current.showModal();
    } else if (!isOpen && dialogRef.current?.open) {
      dialogRef.current.close();
    }
  }, [isOpen]);

  useEffect(() => {
    if (vendors.length > 0 && !selectedVendorId) {
      setSelectedVendorId(vendors[0].id);
    }
  }, [vendors, selectedVendorId]);

  if (!isOpen) return null;

  const handleImport = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!file || !selectedVendorId) return;

    try {
      setIsUploading(true);
      setErrorMessage(null);
      const summary = await apiClient.importCatalog(selectedVendorId, file, JSON.stringify(mapping));
      setImportSummary(summary);
      await loadVendors();
      setIsUploading(false);
    } catch (err: unknown) {
      setIsUploading(false);
      setErrorMessage(err instanceof Error ? err.message : 'Error al importar catálogo');
    }
  };

  const handleCreateVendor = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newName.trim()) return;

    try {
      setIsUploading(true);
      setErrorMessage(null);
      const created = await apiClient.createVendor({
        name: newName,
        locality: newLocality,
        whatsapp_phone: newPhone || null,
        cash_discount_pct: parseFloat(newDiscount) || 0,
        estimate_delivery_fee_ars: parseFloat(newDelivery) || 0,
        acopio_config: {
          enabled: acopioEnabled,
          min_down_payment_pct: parseFloat(acopioDownPayment) || 100,
          freeze_days: parseInt(acopioFreezeDays, 10) || 30,
          max_withdrawal_days: 90,
          min_notice_hours: 24,
        },
      });
      await loadVendors();
      setSelectedVendorId(created.id);
      setActiveTab('import');
      setIsUploading(false);
    } catch (err: unknown) {
      setIsUploading(false);
      setErrorMessage(err instanceof Error ? err.message : 'Error al registrar comercio');
    }
  };

  return (
    <dialog
      ref={dialogRef}
      aria-labelledby="catalog-modal-title"
      onClose={onClose}
      className="fixed inset-0 m-auto w-full max-w-2xl bg-surface-elevated border border-surface-hairline rounded-container shadow-2xl p-0 text-content-primary backdrop:bg-black/50 backdrop:backdrop-blur-xs focus:outline-none"
    >
      <div className="flex flex-col max-h-[90vh]">
        {/* Cabecera */}
        <div className="p-4 border-b border-surface-hairline flex items-center justify-between bg-surface-subtle">
          <div className="flex items-center gap-2.5">
            <div className="p-1.5 rounded-control bg-action-primary/10 text-action-primary">
              <Store className="w-5 h-5" />
            </div>
            <div>
              <h2 id="catalog-modal-title" className="text-sm font-bold text-content-primary">
                Gestor de Corralones, Listas de Precios y Acopio
              </h2>
              <p className="text-[11px] text-content-secondary">
                Importación con deduplicación incremental SHA-256 de archivos Excel/CSV.
              </p>
            </div>
          </div>
          <button
            onClick={onClose}
            type="button"
            className="p-1.5 rounded-control hover:bg-surface-elevated text-content-secondary hover:text-content-primary transition"
            aria-label="Cerrar ventana"
          >
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* Pestañas Accesibles */}
        <div role="tablist" className="flex border-b border-surface-hairline bg-surface-canvas px-4">
          <button
            role="tab"
            aria-selected={activeTab === 'import'}
            onClick={() => setActiveTab('import')}
            type="button"
            className={`py-2.5 px-4 text-xs font-bold border-b-2 transition ${
              activeTab === 'import'
                ? 'border-action-primary text-action-primary'
                : 'border-transparent text-content-secondary hover:text-content-primary'
            }`}
          >
            Importar Lista de Precios (.xlsx / .csv)
          </button>
          <button
            role="tab"
            aria-selected={activeTab === 'new_vendor'}
            onClick={() => setActiveTab('new_vendor')}
            type="button"
            className={`py-2.5 px-4 text-xs font-bold border-b-2 transition ${
              activeTab === 'new_vendor'
                ? 'border-action-primary text-action-primary'
                : 'border-transparent text-content-secondary hover:text-content-primary'
            }`}
          >
            + Registrar Nuevo Corralón
          </button>
        </div>

        {/* Cuerpo */}
        <div className="p-5 overflow-y-auto space-y-4 flex-1">
          {errorMessage && (
            <div role="alert" className="p-3 bg-action-danger/10 border border-action-danger/30 rounded-control text-xs text-action-danger font-medium flex items-center gap-2">
              <AlertTriangle className="w-4 h-4 shrink-0" />
              <span>{errorMessage}</span>
            </div>
          )}

          {activeTab === 'import' && (
            <form onSubmit={handleImport} className="space-y-4">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label htmlFor="vendor-select" className="block text-xs font-semibold text-content-secondary mb-1">
                    Comercio a Actualizar:
                  </label>
                  <select
                    id="vendor-select"
                    value={selectedVendorId}
                    onChange={(e) => setSelectedVendorId(e.target.value)}
                    className="w-full bg-surface-subtle border border-surface-hairline rounded-control p-2 text-xs text-content-primary focus:outline-none"
                  >
                    {vendors.map((v) => (
                      <option key={v.id} value={v.id}>
                        {v.name} ({v.locality})
                      </option>
                    ))}
                  </select>
                </div>

                <div>
                  <span className="block text-xs font-semibold text-content-secondary mb-1">
                    Plantilla de Demostración:
                  </span>
                  <a
                    href={apiClient.getSampleTemplateUrl()}
                    download="plantilla_materiales_ejemplo.csv"
                    className="flex items-center justify-center gap-1.5 w-full bg-surface-subtle hover:bg-surface-canvas border border-surface-hairline text-content-primary rounded-control p-2 text-xs font-semibold transition"
                  >
                    <Download className="w-3.5 h-3.5 text-action-primary" />
                    <span>Descargar Plantilla CSV</span>
                  </a>
                </div>
              </div>

              {/* Subida de archivo con target size accesible */}
              <div>
                <label className="block text-xs font-semibold text-content-secondary mb-1">
                  Archivo de Lista de Precios (.xlsx o .csv):
                </label>
                <input
                  type="file"
                  accept=".csv,.xlsx,.xls"
                  onChange={(e) => setFile(e.target.files?.[0] || null)}
                  className="w-full text-xs text-content-secondary file:mr-3 file:py-2 file:px-3 file:rounded-control file:border-0 file:text-xs file:font-semibold file:bg-surface-subtle file:text-content-primary hover:file:bg-surface-strong/20 cursor-pointer"
                />
              </div>

              {/* Mapeador de columnas */}
              <div className="bg-surface-subtle p-3 rounded-control border border-surface-hairline space-y-2">
                <span className="text-[11px] font-semibold text-content-primary uppercase tracking-wide">
                  Mapeo de Columnas de la Planilla:
                </span>
                <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
                  <div>
                    <label className="text-[10px] text-content-muted font-semibold">Columna SKU</label>
                    <input
                      type="text"
                      value={mapping.sku_col}
                      onChange={(e) => setMapping({ ...mapping, sku_col: e.target.value })}
                      className="w-full bg-surface-elevated border border-surface-hairline rounded-control px-2 py-1 text-content-primary text-xs"
                    />
                  </div>
                  <div>
                    <label className="text-[10px] text-content-muted font-semibold">Columna Descripción</label>
                    <input
                      type="text"
                      value={mapping.desc_col}
                      onChange={(e) => setMapping({ ...mapping, desc_col: e.target.value })}
                      className="w-full bg-surface-elevated border border-surface-hairline rounded-control px-2 py-1 text-content-primary text-xs"
                    />
                  </div>
                  <div>
                    <label className="text-[10px] text-content-muted font-semibold">Columna Precio Contado</label>
                    <input
                      type="text"
                      value={mapping.price_cash_col}
                      onChange={(e) => setMapping({ ...mapping, price_cash_col: e.target.value })}
                      className="w-full bg-surface-elevated border border-surface-hairline rounded-control px-2 py-1 text-content-primary text-xs"
                    />
                  </div>
                  <div>
                    <label className="text-[10px] text-content-muted font-semibold">Columna Precio Lista</label>
                    <input
                      type="text"
                      value={mapping.price_list_col || ''}
                      onChange={(e) => setMapping({ ...mapping, price_list_col: e.target.value })}
                      className="w-full bg-surface-elevated border border-surface-hairline rounded-control px-2 py-1 text-content-primary text-xs"
                    />
                  </div>
                </div>
              </div>

              {/* Resumen de Deduplicación SHA-256 */}
              {importSummary && (
                <div className="p-3 bg-semantic-winnerBg text-semantic-winnerText border border-surface-hairline rounded-control text-xs space-y-2">
                  <div className="flex items-center gap-1.5 font-bold font-sans">
                    <CheckCircle2 className="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
                    <span>¡Catálogo Versión {importSummary.version_number} Importado con Éxito!</span>
                  </div>
                  <div className="grid grid-cols-3 gap-2 pt-1 text-[11px] font-mono">
                    <div>Total Filas: <strong className="tabular-nums">{importSummary.total_rows}</strong></div>
                    <div className="text-amber-700 dark:text-amber-300">Nuevas: <strong className="tabular-nums">{importSummary.new_or_updated_rows}</strong></div>
                    <div className="text-emerald-700 dark:text-emerald-400">Reutilizadas SHA-256: <strong className="tabular-nums">{importSummary.unchanged_skipped_rows}</strong></div>
                  </div>
                </div>
              )}

              <div className="flex justify-end gap-2 pt-2 border-t border-surface-hairline">
                <button
                  type="button"
                  onClick={onClose}
                  className="px-3.5 py-2 rounded-control border border-surface-hairline bg-surface-subtle text-content-secondary hover:text-content-primary text-xs font-semibold"
                >
                  Cerrar
                </button>
                <button
                  type="submit"
                  disabled={isUploading || !file}
                  className="inline-flex items-center gap-1.5 px-4 py-2 rounded-control bg-action-primary hover:bg-action-hover text-white font-bold text-xs shadow-sm transition disabled:opacity-50 min-h-[38px]"
                >
                  {isUploading ? (
                    <>
                      <Loader2 className="w-3.5 h-3.5 animate-spin" />
                      <span>Procesando Hash SHA-256...</span>
                    </>
                  ) : (
                    <>
                      <Upload className="w-3.5 h-3.5" />
                      <span>Importar Lista</span>
                    </>
                  )}
                </button>
              </div>
            </form>
          )}

          {activeTab === 'new_vendor' && (
            <form onSubmit={handleCreateVendor} className="space-y-3.5">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-semibold text-content-secondary mb-1">Nombre del Comercio:</label>
                  <input
                    type="text"
                    required
                    value={newName}
                    onChange={(e) => setNewName(e.target.value)}
                    placeholder="Ej. Corralón Norte Jujuy"
                    className="w-full bg-surface-subtle border border-surface-hairline rounded-control p-2 text-xs text-content-primary"
                  />
                </div>
                <div>
                  <label className="block text-xs font-semibold text-content-secondary mb-1">Localidad:</label>
                  <input
                    type="text"
                    required
                    value={newLocality}
                    onChange={(e) => setNewLocality(e.target.value)}
                    placeholder="San Salvador de Jujuy / Palpalá / Perico"
                    className="w-full bg-surface-subtle border border-surface-hairline rounded-control p-2 text-xs text-content-primary"
                  />
                </div>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div>
                  <label className="block text-xs font-semibold text-content-secondary mb-1">Teléfono WhatsApp:</label>
                  <input
                    type="text"
                    value={newPhone}
                    onChange={(e) => setNewPhone(e.target.value)}
                    placeholder="+543884..."
                    className="w-full bg-surface-subtle border border-surface-hairline rounded-control p-2 text-xs text-content-primary"
                  />
                </div>
                <div>
                  <label className="block text-xs font-semibold text-content-secondary mb-1">Desc. Contado (%):</label>
                  <input
                    type="number"
                    value={newDiscount}
                    onChange={(e) => setNewDiscount(e.target.value)}
                    className="w-full bg-surface-subtle border border-surface-hairline rounded-control p-2 text-xs text-content-primary font-mono tabular-nums"
                  />
                </div>
                <div>
                  <label className="block text-xs font-semibold text-content-secondary mb-1">Flete Base (ARS):</label>
                  <input
                    type="number"
                    value={newDelivery}
                    onChange={(e) => setNewDelivery(e.target.value)}
                    className="w-full bg-surface-subtle border border-surface-hairline rounded-control p-2 text-xs text-content-primary font-mono tabular-nums"
                  />
                </div>
              </div>

              {/* Reglas de Acopio */}
              <div className="p-3 bg-surface-subtle rounded-control border border-surface-hairline space-y-2">
                <div className="flex items-center justify-between">
                  <span className="text-xs font-bold text-content-primary flex items-center gap-1.5">
                    <Clock className="w-3.5 h-3.5 text-action-primary" />
                    Reglas de Acopio de Materiales
                  </span>
                  <label className="flex items-center gap-1.5 text-xs text-content-secondary cursor-pointer select-none">
                    <input
                      type="checkbox"
                      checked={acopioEnabled}
                      onChange={(e) => setAcopioEnabled(e.target.checked)}
                      className="rounded-control border-surface-strong text-action-primary focus:ring-action-focus w-4 h-4"
                    />
                    <span>Habilitar Acopio</span>
                  </label>
                </div>

                {acopioEnabled && (
                  <div className="grid grid-cols-2 gap-3 text-xs pt-1">
                    <div>
                      <label className="text-[10px] text-content-muted font-semibold">% Anticipo Requerido</label>
                      <input
                        type="number"
                        value={acopioDownPayment}
                        onChange={(e) => setAcopioDownPayment(e.target.value)}
                        className="w-full bg-surface-elevated border border-surface-hairline rounded-control p-1.5 text-content-primary font-mono tabular-nums"
                      />
                    </div>
                    <div>
                      <label className="text-[10px] text-content-muted font-semibold">Días Congelamiento de Precio</label>
                      <input
                        type="number"
                        value={acopioFreezeDays}
                        onChange={(e) => setAcopioFreezeDays(e.target.value)}
                        className="w-full bg-surface-elevated border border-surface-hairline rounded-control p-1.5 text-content-primary font-mono tabular-nums"
                      />
                    </div>
                  </div>
                )}
              </div>

              <div className="flex justify-end gap-2 pt-2 border-t border-surface-hairline">
                <button
                  type="button"
                  onClick={onClose}
                  className="px-3.5 py-2 rounded-control border border-surface-hairline bg-surface-subtle text-content-secondary hover:text-content-primary text-xs font-semibold"
                >
                  Cancelar
                </button>
                <button
                  type="submit"
                  disabled={isUploading}
                  className="inline-flex items-center gap-1.5 px-4 py-2 rounded-control bg-action-primary hover:bg-action-hover text-white font-bold text-xs shadow-sm transition min-h-[38px]"
                >
                  <Plus className="w-3.5 h-3.5" />
                  <span>Guardar Corralón</span>
                </button>
              </div>
            </form>
          )}
        </div>
      </div>
    </dialog>
  );
};
</file>

<file path="frontend/src/pages/BuilderDashboardPage.tsx">
import React, { useEffect } from 'react';
import { useWorkspaceStore } from '../store/useWorkspaceStore';
import { useRequisitionStore } from '../store/useRequisitionStore';
import { useComparisonStore } from '../store/useComparisonStore';
import { IngestionDropzone } from '../components/IngestionDropzone';
import { DisambiguationTable } from '../components/DisambiguationTable';
import { MultiVendorMatrix } from '../components/MultiVendorMatrix';
import { SplitCartOptimizerCard } from '../components/SplitCartOptimizerCard';
import { AcopioSimulatorPanel } from '../components/AcopioSimulatorPanel';
import { Store, RefreshCw, Layers } from 'lucide-react';

interface BuilderDashboardPageProps {
  onOpenCatalogs: () => void;
}

export const BuilderDashboardPage: React.FC<BuilderDashboardPageProps> = ({ onOpenCatalogs }) => {
  const { role } = useWorkspaceStore();
  const { currentRequisition, resetRequisition } = useRequisitionStore();
  const {
    vendors,
    selectedVendorIds,
    currentMatrix,
    loadVendors,
    toggleVendorSelection,
    resetComparison,
  } = useComparisonStore();

  useEffect(() => {
    loadVendors();
  }, [loadVendors]);

  const handleNewBudget = () => {
    resetRequisition();
    resetComparison();
  };

  return (
    <div className="max-w-[1600px] mx-auto px-4 sm:px-6 py-5 space-y-5">
      {/* Barra de Encabezado Técnico de la Consola */}
      <div className="bg-surface-elevated border border-surface-hairline rounded-container p-4 flex flex-col md:flex-row md:items-center justify-between gap-4 transition-colors">
        <div className="flex items-center gap-3">
          <div className="h-9 w-9 rounded-control bg-surface-subtle border border-surface-hairline flex items-center justify-center text-action-primary shrink-0">
            <Layers className="w-5 h-5" />
          </div>
          <div>
            <h1 className="text-base sm:text-lg font-display font-extrabold text-content-primary tracking-tight">
              Consola de Cómputo Métrico y Compulsa Multi-Corralón
            </h1>
            <p className="text-xs text-content-secondary mt-0.5">
              {role === 'ESTIMATOR'
                ? 'Perfil Presupuestador Profesional: Margen de honorarios, compulsa técnica y emisión de ofertas al comitente.'
                : 'Perfil Comprador de Obra: Enfoque en ahorro neto de bolsillo y comparativa directa entre corralones.'}
            </p>
          </div>
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <button
            onClick={onOpenCatalogs}
            type="button"
            className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-control bg-surface-subtle hover:bg-surface-elevated text-content-primary border border-surface-hairline text-xs font-semibold transition"
          >
            <Store className="w-3.5 h-3.5 text-action-primary" />
            <span>Gestionar Corralones ({vendors.length})</span>
          </button>

          {currentRequisition && (
            <button
              onClick={handleNewBudget}
              type="button"
              className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-control bg-surface-subtle hover:bg-surface-elevated text-content-secondary hover:text-content-primary border border-surface-hairline text-xs font-semibold transition"
            >
              <RefreshCw className="w-3.5 h-3.5" />
              <span>Nuevo Pedido</span>
            </button>
          )}
        </div>
      </div>

      {/* Selector Rápido de Corralones Participantes */}
      <div className="bg-surface-elevated border border-surface-hairline rounded-container p-3.5 space-y-2">
        <div className="flex items-center justify-between text-xs">
          <span className="font-semibold uppercase tracking-wider text-[11px] text-content-secondary">
            Corralones Seleccionados para la Compulsa ({selectedVendorIds.length} de {vendors.length}):
          </span>
          <span className="text-[11px] text-content-muted">
            Haz clic para incluir o excluir comercios
          </span>
        </div>

        <div className="flex flex-wrap gap-2 pt-0.5">
          {vendors.map((v) => {
            const isSelected = selectedVendorIds.includes(v.id);

            return (
              <button
                key={v.id}
                type="button"
                onClick={() => toggleVendorSelection(v.id)}
                className={`inline-flex items-center gap-2 px-3 py-1.5 rounded-control text-xs font-semibold border transition ${
                  isSelected
                    ? 'bg-action-primary/10 border-action-primary/40 text-action-primary shadow-xs'
                    : 'bg-surface-subtle border-surface-hairline text-content-muted hover:text-content-secondary'
                }`}
              >
                <div
                  className={`w-2 h-2 rounded-full ${
                    isSelected ? 'bg-action-primary' : 'bg-surface-strong'
                  }`}
                />
                <span>{v.name}</span>
                <span className="text-[10px] font-mono text-content-muted">({v.locality})</span>
              </button>
            );
          })}
        </div>
      </div>

      {/* Layout Asimétrico 12 Columnas: 8 Izquierda (Flujo Técnico) + 4 Derecha (Sticky Financiero) */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
        {/* Zona Izquierda: 8 Columnas */}
        <div className="lg:col-span-8 space-y-5">
          {/* Paso 01: Ingesta Multimodal */}
          <IngestionDropzone />

          {/* Paso 02: Desambiguación HITL */}
          {currentRequisition && (
            <DisambiguationTable
              onProceedToCompare={() => {
                // Compulsa ejecutada
              }}
            />
          )}

          {/* Paso 03: Matriz Multi-Proveedor */}
          {currentMatrix && <MultiVendorMatrix />}
        </div>

        {/* Zona Derecha: 4 Columnas Sticky */}
        <div className="lg:col-span-4 lg:sticky lg:top-18 space-y-4">
          <SplitCartOptimizerCard
            onLockBudget={() => {
              // Presupuesto congelado
            }}
          />

          <AcopioSimulatorPanel />
        </div>
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/pages/PublicBudgetViewPage.tsx">
import React, { useEffect, useState } from 'react';
import { apiClient } from '../services/apiClient';
import { ComparisonMatrixResponse } from '../types/api';
import { Download, Lock, ArrowLeft, Loader2, FileText } from 'lucide-react';

interface PublicBudgetViewPageProps {
  shareToken: string;
}

export const PublicBudgetViewPage: React.FC<PublicBudgetViewPageProps> = ({ shareToken }) => {
  const [data, setData] = useState<ComparisonMatrixResponse | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    async function loadSnapshot() {
      try {
        setLoading(true);
        const res = await apiClient.getPublicComparison(shareToken);
        setData(res);
        setLoading(false);
      } catch (err: unknown) {
        setLoading(false);
        setError(err instanceof Error ? err.message : 'Presupuesto no encontrado o enlace caducado');
      }
    }
    loadSnapshot();
  }, [shareToken]);

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center text-content-secondary gap-2 text-xs font-sans">
        <Loader2 className="w-5 h-5 animate-spin text-action-primary" />
        <span>Cargando pliego presupuestario sellado...</span>
      </div>
    );
  }

  if (error || !data) {
    return (
      <div className="max-w-md mx-auto my-20 p-6 bg-surface-elevated border border-surface-hairline rounded-container text-center space-y-4 font-sans shadow-sm">
        <div className="w-12 h-12 rounded-full bg-action-danger/10 border border-action-danger/30 text-action-danger flex items-center justify-center mx-auto text-xl font-bold font-mono">
          !
        </div>
        <h2 className="text-base font-bold text-content-primary">Enlace No Válido o No Emitido</h2>
        <p className="text-xs text-content-secondary leading-relaxed">
          {error || 'El presupuesto solicitado no ha sido congelado o el token de firma no es válido.'}
        </p>
        <a
          href="/"
          className="inline-flex items-center gap-1.5 px-4 py-2 rounded-control bg-surface-subtle hover:bg-surface-canvas border border-surface-hairline text-xs font-semibold text-content-primary transition"
        >
          <ArrowLeft className="w-3.5 h-3.5" />
          <span>Volver al Inicio</span>
        </a>
      </div>
    );
  }

  return (
    <div className="max-w-5xl mx-auto px-4 sm:px-6 py-8 space-y-6 font-sans">
      {/* Cabecera del Presupuesto Compartido */}
      <div className="bg-surface-elevated border border-surface-hairline rounded-container p-5 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div className="flex items-center gap-2 mb-1.5">
            <span className="text-xs font-mono uppercase px-2 py-0.5 rounded-control bg-semantic-winnerBg text-semantic-winnerText border border-surface-hairline flex items-center gap-1 font-bold">
              <Lock className="w-3 h-3 text-emerald-600 dark:text-emerald-400" /> Snapshot Inmutable HMAC-SHA256
            </span>
            <span className="text-xs text-content-muted font-mono">
              Emitido: {data.created_at.slice(0, 10)}
            </span>
          </div>
          <h1 className="text-lg font-display font-extrabold text-content-primary tracking-tight">
            Pliego Presupuestario y Comparativa de Materiales
          </h1>
          <p className="text-xs text-content-secondary mt-0.5 font-mono">
            Modalidad: <strong>{data.payment_modality}</strong> | Corralones cotizados: <strong>{data.vendors.length}</strong>
          </p>
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <a
            href={`/api/v1/public/comparisons/${shareToken}?format=pdf&mode=comparison`}
            target="_blank"
            rel="noreferrer"
            className="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-control bg-surface-subtle hover:bg-surface-canvas border border-surface-hairline text-content-primary text-xs font-semibold transition"
          >
            <Download className="w-3.5 h-3.5 text-action-primary" />
            <span>PDF Comparativa</span>
          </a>
          <a
            href={`/api/v1/public/comparisons/${shareToken}?format=pdf&mode=client_budget`}
            target="_blank"
            rel="noreferrer"
            className="inline-flex items-center gap-1.5 px-4 py-2 rounded-control bg-action-primary hover:bg-action-hover text-white font-bold text-xs shadow-sm transition"
          >
            <FileText className="w-3.5 h-3.5" />
            <span>Descargar Presupuesto Oficial</span>
          </a>
        </div>
      </div>

      {/* Resumen Comparativo */}
      <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono">
        <div className="bg-surface-elevated border border-surface-hairline rounded-container p-4">
          <div className="text-[10px] font-bold text-content-muted uppercase tracking-wider font-sans">
            Estrategia A · Mejor Proveedor Único
          </div>
          <div className="text-sm font-bold text-content-primary mt-1 font-sans truncate">
            {data.best_single_vendor_name || 'Comercio Único'}
          </div>
          <div className="text-xl font-extrabold text-content-primary tabular-nums mt-1">
            $ {data.best_single_total_ars?.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
          </div>
        </div>

        <div className="bg-surface-elevated border border-surface-hairline rounded-container p-4">
          <div className="text-[10px] font-bold text-content-muted uppercase tracking-wider font-sans">
            Estrategia B · Compra Dividida Óptima (Split Cart)
          </div>
          <div className="text-sm font-bold text-content-primary mt-1 font-sans">
            {data.split_cart.participating_vendors_count} Comercios con Mejor Precio
          </div>
          <div className="text-xl font-extrabold text-emerald-700 dark:text-emerald-400 tabular-nums mt-1">
            $ {data.split_cart.total_cart_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
          </div>
          {data.split_cart.savings_vs_single_vendor_ars > 0 && (
            <div className="text-xs text-semantic-winnerText font-bold mt-1 font-sans">
              Ahorro neto de bolsillo: -$ {data.split_cart.savings_vs_single_vendor_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
            </div>
          )}
        </div>
      </div>

      {/* Tabla de Renglones Cotizados */}
      <div className="bg-surface-elevated border border-surface-hairline rounded-container p-5 shadow-xs overflow-x-auto">
        <h2 className="text-sm font-bold text-content-primary mb-3 font-display">
          Detalle de Renglones y Precios Unitarios
        </h2>
        <table className="w-full text-left text-xs border-collapse">
          <thead>
            <tr className="border-b border-surface-hairline bg-surface-subtle text-content-secondary uppercase text-[11px] font-semibold tracking-wider">
              <th className="py-2.5 px-3 w-10">#</th>
              <th className="py-2.5 px-3">Descripción de Material</th>
              <th className="py-2.5 px-3 text-center">Cantidad</th>
              <th className="py-2.5 px-3 text-right">Mejor Precio</th>
            </tr>
          </thead>
          <tbody className="divide-y divide-surface-hairline font-mono">
            {data.matrix_rows.map((row) => (
              <tr key={row.requisition_item_id} className="hover:bg-surface-subtle/30">
                <td className="py-2.5 px-3 text-content-muted font-sans font-semibold">{row.line_order}</td>
                <td className="py-2.5 px-3 font-medium text-content-primary font-sans">{row.requested_term}</td>
                <td className="py-2.5 px-3 text-center text-content-secondary tabular-nums">
                  {row.quantity} {row.requested_unit}
                </td>
                <td className="py-2.5 px-3 text-right font-extrabold text-emerald-700 dark:text-emerald-400 tabular-nums">
                  $ {row.lowest_price_ars?.toLocaleString('es-AR', { minimumFractionDigits: 2 }) || 'Sin cotización'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/pages/TractionEvidencePage.tsx">
import React, { useEffect, useState } from 'react';
import { apiClient } from '../services/apiClient';
import { TractionMetricsResponse } from '../types/api';
import { ShieldCheck, Users, Building, FileCheck, Clock, ArrowLeft, Loader2 } from 'lucide-react';

export const TractionEvidencePage: React.FC = () => {
  const [metrics, setMetrics] = useState<TractionMetricsResponse | null>(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    async function loadMetrics() {
      try {
        setLoading(true);
        const data = await apiClient.getTractionMetrics();
        setMetrics(data);
        setLoading(false);
      } catch {
        setLoading(false);
      }
    }
    loadMetrics();
  }, []);

  return (
    <div className="max-w-5xl mx-auto px-4 sm:px-6 py-10 space-y-8 font-sans">
      <div className="flex items-center justify-between">
        <a
          href="/"
          className="inline-flex items-center gap-1.5 text-xs font-semibold text-content-secondary hover:text-action-primary transition"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>Volver a la Consola de Compulsa</span>
        </a>
      </div>

      {/* Cabecera de Tracción */}
      <div className="text-center max-w-2xl mx-auto space-y-3">
        <div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-control text-xs font-bold bg-semantic-winnerBg text-semantic-winnerText border border-surface-hairline shadow-xs">
          <ShieldCheck className="w-4 h-4 text-emerald-600 dark:text-emerald-400" />
          <span>Tablero Público Auditable</span>
        </div>
        <h1 className="text-2xl sm:text-3xl font-display font-extrabold text-content-primary tracking-tight">
          Métricas Reales de Compulsa y Ahorro en el NOA
        </h1>
        <p className="text-xs text-content-secondary leading-relaxed">
          Datos agregados transparentes de contratistas, presupuestadores y obras reales en San Salvador de Jujuy, Palpalá, Perico y El Carmen.
        </p>
        <div className="inline-block px-3 py-1 bg-surface-subtle border border-surface-hairline rounded-control text-[11px] text-content-secondary font-mono">
          Filtro estricto: <strong className="text-action-primary">WHERE workspaces.is_demo = FALSE</strong> (cero contaminación de simulaciones)
        </div>
      </div>

      {loading ? (
        <div className="py-20 flex items-center justify-center text-content-secondary gap-2 text-xs">
          <Loader2 className="w-5 h-5 animate-spin text-action-primary" />
          <span>Calculando métricas auditadas desde base de datos...</span>
