<file path="frontend/src/services/apiClient.ts">
/**
 * Cliente HTTP tipado centralizado con gestión de token y workspace_id.
 */

import {
  SessionResponse,
  VendorResponse,
  VendorCreateRequest,
  CatalogImportSummary,
  VendorProductResponse,
  RequisitionDetailResponse,
  RequisitionIngestRequest,
  ItemClarificationResolveRequest,
  ComparisonMatrixResponse,
  RunComparisonRequest,
  ManualVendorMatchOverride,
  LockBudgetResponse,
  TractionMetricsResponse,
  UserRole,
} from '../types/api';

const BASE_URL = '/api/v1';

class ApiClient {
  private token: string | null = null;
  private workspaceId: string | null = null;

  public setToken(token: string | null) {
    this.token = token;
  }

  public setWorkspaceId(workspaceId: string | null) {
    this.workspaceId = workspaceId;
  }

  private getHeaders(customHeaders: Record<string, string> = {}): Record<string, string> {
    const headers: Record<string, string> = {
      ...customHeaders,
    };
    if (this.token) {
      headers['Authorization'] = `Bearer ${this.token}`;
    }
    if (this.workspaceId) {
      headers['X-Workspace-Id'] = this.workspaceId;
    }
    return headers;
  }

  private async request<T>(endpoint: string, options: RequestInit = {}): Promise<T> {
    const headers = this.getHeaders(
      (options.headers as Record<string, string>) || {}
    );

    const response = await fetch(`${BASE_URL}${endpoint}`, {
      ...options,
      headers,
    });

    if (!response.ok) {
      let errorMessage = `Error HTTP ${response.status}: ${response.statusText}`;
      try {
        const errorJson = await response.json();
        if (errorJson?.error?.message) {
          errorMessage = errorJson.error.message;
        } else if (errorJson?.detail) {
          errorMessage = typeof errorJson.detail === 'string' ? errorJson.detail : JSON.stringify(errorJson.detail);
        }
      } catch {
        // Fallback a statusText
      }
      throw new Error(errorMessage);
    }

    return response.json() as Promise<T>;
  }

  // --- Auth & Sesión ---
  public async getDemoSession(): Promise<SessionResponse> {
    return this.request<SessionResponse>('/auth/demo-session', {
      method: 'POST',
    });
  }

  public async switchMode(isDemo: boolean, role: UserRole = 'ESTIMATOR'): Promise<SessionResponse> {
    return this.request<SessionResponse>('/auth/switch-mode', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ is_demo: isDemo, role }),
    });
  }

  public async updateRole(role: UserRole): Promise<{ status: string; role: string }> {
    return this.request<{ status: string; role: string }>('/auth/role', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ role }),
    });
  }

  // --- Vendors & Catálogos ---
  public async listVendors(): Promise<VendorResponse[]> {
    return this.request<VendorResponse[]>('/vendors');
  }

  public async createVendor(payload: VendorCreateRequest): Promise<VendorResponse> {
    return this.request<VendorResponse>('/vendors', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
  }

  public async getVendorProducts(vendorId: string): Promise<VendorProductResponse[]> {
    return this.request<VendorProductResponse[]>(`/vendors/${vendorId}/products`);
  }

  public async importCatalog(
    vendorId: string,
    file: File,
    mappingJson: string
  ): Promise<CatalogImportSummary> {
    const formData = new FormData();
    formData.append('file', file);
    formData.append('mapping_json', mappingJson);

    const headers = this.getHeaders();
    delete headers['Content-Type']; // Permite que el navegador establezca multipart/form-data con boundary

    const response = await fetch(`${BASE_URL}/vendors/${vendorId}/catalogs/import`, {
      method: 'POST',
      headers,
      body: formData,
    });

    if (!response.ok) {
      const err = await response.json().catch(() => ({}));
      throw new Error(err?.error?.message || err?.detail || 'Error al importar catálogo');
    }

    return response.json();
  }

  public getSampleTemplateUrl(): string {
    return `${BASE_URL}/vendors/sample-template/download`;
  }

  // --- Requisiciones & HITL ---
  public async ingestRequisitionForm(formData: FormData): Promise<RequisitionDetailResponse> {
    const headers = this.getHeaders();
    delete headers['Content-Type'];

    const response = await fetch(`${BASE_URL}/requisitions/ingest`, {
      method: 'POST',
      headers,
      body: formData,
    });

    if (!response.ok) {
      const err = await response.json().catch(() => ({}));
      throw new Error(err?.error?.message || err?.detail || 'Error al procesar el pedido');
    }

    return response.json();
  }

  public async ingestRequisitionJson(payload: RequisitionIngestRequest): Promise<RequisitionDetailResponse> {
    return this.request<RequisitionDetailResponse>('/requisitions/ingest-json', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
  }

  public async getRequisition(reqId: string): Promise<RequisitionDetailResponse> {
    return this.request<RequisitionDetailResponse>(`/requisitions/${reqId}`);
  }

  public async resolveItem(
    reqId: string,
    itemId: string,
    payload: ItemClarificationResolveRequest
  ): Promise<RequisitionDetailResponse> {
    return this.request<RequisitionDetailResponse>(
      `/requisitions/${reqId}/items/${itemId}/resolve`,
      {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      }
    );
  }

  // --- Compulsa & Snapshot ---
  public async runComparison(
    reqId: string,
    payload: RunComparisonRequest
  ): Promise<ComparisonMatrixResponse> {
    return this.request<ComparisonMatrixResponse>(`/requisitions/${reqId}/compare`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
  }

  public async getComparison(runId: string): Promise<ComparisonMatrixResponse> {
    return this.request<ComparisonMatrixResponse>(`/comparisons/${runId}`);
  }

  public async overrideMatch(
    runId: string,
    matchId: string,
    payload: ManualVendorMatchOverride
  ): Promise<ComparisonMatrixResponse> {
    return this.request<ComparisonMatrixResponse>(`/comparisons/${runId}/matches/${matchId}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
  }

  public async lockBudget(runId: string): Promise<LockBudgetResponse> {
    return this.request<LockBudgetResponse>(`/comparisons/${runId}/lock-budget`, {
      method: 'POST',
    });
  }

  public getPdfUrl(runId: string, mode: 'comparison' | 'client_budget' = 'comparison'): string {
    return `${BASE_URL}/comparisons/${runId}/pdf?mode=${mode}`;
  }

  // --- Público y Tracción ---
  public async getPublicComparison(shareToken: string): Promise<ComparisonMatrixResponse> {
    return this.request<ComparisonMatrixResponse>(`/public/comparisons/${shareToken}`);
  }

  public async getTractionMetrics(): Promise<TractionMetricsResponse> {
    return this.request<TractionMetricsResponse>('/public/traction');
  }
}

export const apiClient = new ApiClient();
</file>

<file path="frontend/src/store/useComparisonStore.ts">
/**
 * Store global Zustand para Compulsa Multi-Negocio, Split Cart y Snapshot.
 */

import { create } from 'zustand';
import {
  VendorResponse,
  PaymentModality,
  ComparisonMatrixResponse,
  LockBudgetResponse,
} from '../types/api';
import { apiClient } from '../services/apiClient';

interface ComparisonState {
  vendors: VendorResponse[];
  selectedVendorIds: string[];
  paymentModality: PaymentModality;
  markupPct: number;
  includeDeliveryFees: boolean;
  currentMatrix: ComparisonMatrixResponse | null;
  lockedBudget: LockBudgetResponse | null;
  isLoading: boolean;
  error: string | null;

  loadVendors: () => Promise<void>;
  toggleVendorSelection: (vendorId: string) => void;
  setPaymentModality: (modality: PaymentModality) => void;
  setMarkupPct: (markup: number) => void;
  setIncludeDeliveryFees: (include: boolean) => void;
  runComparison: (reqId: string) => Promise<void>;
  lockBudget: () => Promise<void>;
  resetComparison: () => void;
}

export const useComparisonStore = create<ComparisonState>((set, get) => ({
  vendors: [],
  selectedVendorIds: [],
  paymentModality: 'CASH',
  markupPct: 0.0,
  includeDeliveryFees: true,
  currentMatrix: null,
  lockedBudget: null,
  isLoading: false,
  error: null,

  loadVendors: async () => {
    try {
      set({ isLoading: true, error: null });
      const vendors = await apiClient.listVendors();
      const defaultSelected = vendors.map((v) => v.id);
      set({
        vendors,
        selectedVendorIds: defaultSelected,
        isLoading: false,
      });
    } catch (err: unknown) {
      set({
        isLoading: false,
        error: err instanceof Error ? err.message : 'Error al cargar comercios',
      });
    }
  },

  toggleVendorSelection: (vendorId: string) => {
    const current = get().selectedVendorIds;
    if (current.includes(vendorId)) {
      if (current.length > 1) {
        set({ selectedVendorIds: current.filter((id) => id !== vendorId) });
      }
    } else {
      set({ selectedVendorIds: [...current, vendorId] });
    }
  },

  setPaymentModality: (paymentModality: PaymentModality) => {
    set({ paymentModality });
  },

  setMarkupPct: (markupPct: number) => {
    set({ markupPct });
  },

  setIncludeDeliveryFees: (includeDeliveryFees: boolean) => {
    set({ includeDeliveryFees });
  },

  runComparison: async (reqId: string) => {
    const { selectedVendorIds, paymentModality, markupPct, includeDeliveryFees } = get();
    if (selectedVendorIds.length === 0) {
      set({ error: 'Debe seleccionar al menos un comercio para comparar' });
      return;
    }

    try {
      set({ isLoading: true, error: null });
      const matrix = await apiClient.runComparison(reqId, {
        vendor_ids: selectedVendorIds,
        payment_modality: paymentModality,
        markup_pct: markupPct,
        include_delivery_fees: includeDeliveryFees,
      });
      set({ currentMatrix: matrix, isLoading: false });
    } catch (err: unknown) {
      set({
        isLoading: false,
        error: err instanceof Error ? err.message : 'Error al ejecutar compulsa',
      });
    }
  },

  lockBudget: async () => {
    const matrix = get().currentMatrix;
    if (!matrix) return;

    try {
      set({ isLoading: true, error: null });
      const lockRes = await apiClient.lockBudget(matrix.run_id);
      set({ lockedBudget: lockRes, isLoading: false });
    } catch (err: unknown) {
      set({
        isLoading: false,
        error: err instanceof Error ? err.message : 'Error al congelar presupuesto',
      });
    }
  },

  resetComparison: () => {
    set({ currentMatrix: null, lockedBudget: null, error: null });
  },
}));
</file>

