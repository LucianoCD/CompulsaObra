        <DisambiguationTable
          onProceedToCompare={() => {
            // Ya dispara runComparison
          }}
        />
      )}

      {/* Paso 3: Matriz Comparativa y Carrito Dividido */}
      {currentMatrix && (
        <>
          <MultiVendorMatrix />
          <SplitCartOptimizerCard
            onLockBudget={() => {
              // Notificar o refrescar
            }}
          />
          <AcopioSimulatorPanel />
        </>
      )}

      {/* Modal de Catálogos */}
      <VendorCatalogModal
        isOpen={isCatalogModalOpen}
        onClose={() => setIsCatalogModalOpen(false)}
      />
    </div>
  );
};
