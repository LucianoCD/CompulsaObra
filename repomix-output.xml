<file path="frontend/src/components/IngestionDropzone.tsx">
import React, { useState } from 'react';
import { useRequisitionStore } from '../store/useRequisitionStore';
import {
  FileText,
  Upload,
  MessageSquare,
  ArrowRight,
  Loader2,
  Cpu,
  FileCheck2,
  Image as ImageIcon,
} from 'lucide-react';

export const IngestionDropzone: React.FC = () => {
  const { ingestPreset, ingestText, ingestFile, isLoading, error } = useRequisitionStore();
  const [activeTab, setActiveTab] = useState<'presets' | 'text' | 'image'>('presets');
  const [title, setTitle] = useState('Pedido de Materiales - Obra');
  const [clientName, setClientName] = useState('');
  const [rawText, setRawText] = useState(
    '50 bolsas de cemento avellaneda\n40 barras del 8\n20 hierro del 10\n4 caño de 3/4\n5 caño PVC 40 mm'
  );
  const [selectedFile, setSelectedFile] = useState<File | null>(null);

  const handleTextSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!rawText.trim()) return;
    ingestText(title, rawText);
  };

  const handleFileSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    if (!selectedFile) return;
    ingestFile(title, selectedFile);
  };

  const handleKeyDownTextarea = (e: React.KeyboardEvent<HTMLTextAreaElement>) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
      e.preventDefault();
      if (rawText.trim()) {
        ingestText(title, rawText);
      }
    }
  };

  return (
    <section
      aria-labelledby="ingestion-heading"
      className="bg-surface-elevated border border-surface-hairline rounded-container p-4 sm:p-5 transition-colors"
    >
      <div className="flex flex-col sm:flex-row sm:items-center justify-between pb-3.5 border-b border-surface-hairline gap-3">
        <div>
          <div className="flex items-center gap-2">
            <span className="font-mono text-xs font-bold px-2 py-0.5 rounded-control bg-surface-subtle text-action-primary border border-surface-hairline">
              PASO 01
            </span>
            <h2 id="ingestion-heading" className="text-sm sm:text-base font-display font-bold text-content-primary">
              Ingesta Multimodal y Normalización Dimensional
            </h2>
          </div>
          <p className="text-xs text-content-secondary mt-1">
            Procesa pliegos manuscritos, mensajes de WhatsApp o carga presets instantáneos calibrados para el NOA.
          </p>
        </div>

        {/* Selector de Pestañas con Roles Accesibles */}
        <div
          role="tablist"
          aria-label="Modalidades de carga de pliego"
          className="flex bg-surface-subtle p-1 rounded-control border border-surface-hairline self-start sm:self-auto"
        >
          <button
            role="tab"
            aria-selected={activeTab === 'presets'}
            onClick={() => setActiveTab('presets')}
            className={`px-3 py-1.5 rounded-control text-xs font-medium transition ${
              activeTab === 'presets'
                ? 'bg-surface-elevated text-content-primary font-bold shadow-sm'
                : 'text-content-secondary hover:text-content-primary'
            }`}
          >
            Presets Rápidos
          </button>
          <button
            role="tab"
            aria-selected={activeTab === 'text'}
            onClick={() => setActiveTab('text')}
            className={`px-3 py-1.5 rounded-control text-xs font-medium transition ${
              activeTab === 'text'
                ? 'bg-surface-elevated text-content-primary font-bold shadow-sm'
                : 'text-content-secondary hover:text-content-primary'
            }`}
          >
            Texto / WhatsApp
          </button>
          <button
            role="tab"
            aria-selected={activeTab === 'image'}
            onClick={() => setActiveTab('image')}
            className={`px-3 py-1.5 rounded-control text-xs font-medium transition ${
              activeTab === 'image'
                ? 'bg-surface-elevated text-content-primary font-bold shadow-sm'
                : 'text-content-secondary hover:text-content-primary'
            }`}
          >
            Foto Manuscrita
          </button>
        </div>
      </div>

      {error && (
        <div
          role="alert"
          className="mt-3.5 p-3 bg-action-danger/10 border border-action-danger/30 rounded-control text-xs text-action-danger font-medium flex items-center gap-2"
        >
          <span>{error}</span>
        </div>
      )}

      {/* Contenido de Ingesta */}
      <div className="mt-4">
        {/* Pestaña Presets */}
        {activeTab === 'presets' && (
          <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
            <button
              onClick={() => ingestPreset('whatsapp_jerga_noa')}
              disabled={isLoading}
              type="button"
              className="text-left p-3.5 rounded-control bg-surface-subtle hover:bg-surface-elevated border border-surface-hairline hover:border-surface-strong transition group flex flex-col justify-between min-h-[140px]"
            >
              <div>
                <div className="flex items-center justify-between mb-2">
                  <div className="p-1.5 rounded-control bg-action-primary/10 text-action-primary">
                    <MessageSquare className="w-4 h-4" />
                  </div>
                  <span className="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded-control bg-surface-elevated text-content-muted border border-surface-hairline">
                    Preset 1
                  </span>
                </div>
                <h3 className="text-xs font-bold text-content-primary group-hover:text-action-primary transition">
                  WhatsApp con Jerga NOA
                </h3>
                <p className="text-[11px] text-content-secondary mt-1 leading-snug">
                  "50 bolsas cemento, 40 barras del 8, 20 hierro del 10 y caños".
                </p>
              </div>
              <div className="mt-3 flex items-center text-xs text-action-primary font-semibold gap-1">
                <span>Cargar en 1 clic</span>
                <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition" />
              </div>
            </button>

            <button
              onClick={() => ingestPreset('manuscrito_obra')}
              disabled={isLoading}
              type="button"
              className="text-left p-3.5 rounded-control bg-semantic-hitlBg/40 hover:bg-semantic-hitlBg/70 border border-semantic-hitlBorder/60 hover:border-semantic-hitlBorder transition group flex flex-col justify-between min-h-[140px]"
            >
              <div>
                <div className="flex items-center justify-between mb-2">
                  <div className="p-1.5 rounded-control bg-amber-500/20 text-amber-700 dark:text-amber-400">
                    <FileText className="w-4 h-4" />
                  </div>
                  <span className="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded-control bg-surface-elevated text-content-muted border border-surface-hairline">
                    Preset 2 (E2E-01)
                  </span>
                </div>
                <h3 className="text-xs font-bold text-content-primary group-hover:text-amber-700 dark:group-hover:text-amber-400 transition">
                  Manuscrito de Obra (Guardia HITL)
                </h3>
                <p className="text-[11px] text-content-secondary mt-1 leading-snug">
                  "20 barra del 8 y 4 caño de 3/4" (detecta atributo faltante).
                </p>
              </div>
              <div className="mt-3 flex items-center text-xs text-amber-700 dark:text-amber-400 font-bold gap-1">
                <span>Probar Desambiguación</span>
                <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition" />
              </div>
            </button>

            <button
              onClick={() => ingestPreset('computo_tecnico')}
              disabled={isLoading}
              type="button"
              className="text-left p-3.5 rounded-control bg-surface-subtle hover:bg-surface-elevated border border-surface-hairline hover:border-surface-strong transition group flex flex-col justify-between min-h-[140px]"
            >
              <div>
                <div className="flex items-center justify-between mb-2">
                  <div className="p-1.5 rounded-control bg-blue-500/10 text-blue-600 dark:text-blue-400">
                    <Cpu className="w-4 h-4" />
                  </div>
                  <span className="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded-control bg-surface-elevated text-content-muted border border-surface-hairline">
                    Preset 3
                  </span>
                </div>
                <h3 className="text-xs font-bold text-content-primary group-hover:text-blue-600 dark:group-hover:text-blue-400 transition">
                  Cómputo Técnico Completo
                </h3>
                <p className="text-[11px] text-content-secondary mt-1 leading-snug">
                  Pliego con caños cloacales 110mm, 40mm y hierros aletados.
                </p>
              </div>
              <div className="mt-3 flex items-center text-xs text-blue-600 dark:text-blue-400 font-semibold gap-1">
                <span>Cargar Pliego Técnico</span>
                <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition" />
              </div>
            </button>
          </div>
        )}

        {/* Pestaña Texto Libre / WhatsApp */}
        {activeTab === 'text' && (
          <form onSubmit={handleTextSubmit} className="space-y-3.5">
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label htmlFor="req-title" className="block text-xs font-semibold text-content-secondary mb-1">
                  Título del Pedido u Obra:
                </label>
                <input
                  id="req-title"
                  type="text"
                  required
                  value={title}
                  onChange={(e) => setTitle(e.target.value)}
                  className="w-full bg-surface-subtle border border-surface-hairline focus:border-surface-strong rounded-control px-3 py-1.5 text-xs text-content-primary focus:outline-none"
                  placeholder="Ej. Casa Barrio Los Perales - Lote 4"
                />
              </div>
              <div>
                <label htmlFor="req-client" className="block text-xs font-semibold text-content-secondary mb-1">
                  Cliente o Comitente (Opcional):
                </label>
                <input
                  id="req-client"
                  type="text"
                  value={clientName}
                  onChange={(e) => setClientName(e.target.value)}
                  className="w-full bg-surface-subtle border border-surface-hairline focus:border-surface-strong rounded-control px-3 py-1.5 text-xs text-content-primary focus:outline-none"
                  placeholder="Ej. Ing. Juan Pérez / Constructora Jujuy"
                />
              </div>
            </div>

            <div>
              <div className="flex items-center justify-between mb-1">
                <label htmlFor="req-raw-text" className="block text-xs font-semibold text-content-secondary">
                  Texto del Pedido o Mensaje de WhatsApp:
                </label>
                <span className="text-[10px] text-content-muted font-mono">
                  Presiona <kbd className="px-1 py-0.5 rounded bg-surface-subtle border border-surface-hairline">Ctrl</kbd> + <kbd className="px-1 py-0.5 rounded bg-surface-subtle border border-surface-hairline">Enter</kbd> para procesar
                </span>
              </div>
              <textarea
                id="req-raw-text"
                rows={5}
                required
                value={rawText}
                onChange={(e) => setRawText(e.target.value)}
                onKeyDown={handleKeyDownTextarea}
                className="w-full bg-surface-subtle border border-surface-hairline focus:border-surface-strong rounded-control p-3 text-xs font-mono text-content-primary focus:outline-none leading-relaxed"
                placeholder="Pegar aquí la lista con cantidades y medidas (ej. 20 barra del 8 y 4 caño de 3/4)..."
              />
            </div>

            <div className="flex justify-end">
              <button
                type="submit"
                disabled={isLoading || !rawText.trim()}
                className="inline-flex items-center gap-2 px-4 py-2 rounded-control bg-action-primary hover:bg-action-hover text-white font-semibold text-xs shadow-sm transition disabled:opacity-50 min-h-[40px]"
              >
                {isLoading ? (
                  <>
                    <Loader2 className="w-4 h-4 animate-spin" />
                    <span>Normalizando unidades y jerga NOA...</span>
                  </>
                ) : (
                  <>
                    <FileCheck2 className="w-4 h-4" />
                    <span>Extraer y Normalizar Materiales</span>
                  </>
                )}
              </button>
            </div>
          </form>
        )}

        {/* Pestaña Foto Manuscrita con Alternativa Accesible a Drag-and-Drop (WCAG 2.5.7 & 2.5.8) */}
        {activeTab === 'image' && (
          <form onSubmit={handleFileSubmit} className="space-y-3.5">
            <div className="border border-dashed border-surface-strong/70 rounded-control p-6 text-center bg-surface-subtle/50 transition">
              <div className="w-10 h-10 rounded-full bg-surface-elevated border border-surface-hairline flex items-center justify-center mx-auto mb-2 text-action-primary">
                <ImageIcon className="w-5 h-5" />
              </div>
              <p className="text-xs font-semibold text-content-primary mb-1">
                Sube una fotografía de remito, libreta de obra o plano de cómputo
              </p>
              <p className="text-[11px] text-content-muted mb-3">
                Formatos compatibles: JPEG, PNG o WebP (límite máximo 10 MB)
              </p>

              {/* Input de archivo nativo oculto pero disparado por botón de 44px (WCAG 2.5.7 y 2.5.8) */}
              <input
                id="file-upload-input"
                type="file"
                accept="image/*"
                onChange={(e) => setSelectedFile(e.target.files?.[0] || null)}
                className="sr-only"
              />
              <label
                htmlFor="file-upload-input"
                className="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-control bg-surface-elevated hover:bg-surface-subtle border border-surface-strong text-content-primary text-xs font-bold transition shadow-sm cursor-pointer min-h-[44px]"
              >
                <Upload className="w-4 h-4 text-action-primary" />
                <span>{selectedFile ? 'Cambiar archivo seleccionado' : 'Explorar y Seleccionar Imagen'}</span>
              </label>

              {selectedFile && (
                <div className="mt-3 inline-block px-3 py-1 bg-surface-elevated border border-surface-hairline rounded-control text-xs font-mono text-content-secondary">
                  Archivo cargado: <strong>{selectedFile.name}</strong> ({Math.round(selectedFile.size / 1024)} KB)
                </div>
              )}
            </div>

            <div className="flex justify-end">
              <button
                type="submit"
                disabled={isLoading || !selectedFile}
                className="inline-flex items-center gap-2 px-4 py-2 rounded-control bg-action-primary hover:bg-action-hover text-white font-semibold text-xs shadow-sm transition disabled:opacity-50 min-h-[40px]"
              >
                {isLoading ? (
                  <>
                    <Loader2 className="w-4 h-4 animate-spin" />
                    <span>Extrayendo con IA Multimodal...</span>
                  </>
                ) : (
                  <>
                    <Upload className="w-4 h-4" />
                    <span>Procesar Fotografía</span>
                  </>
                )}
              </button>
            </div>
          </form>
        )}
      </div>
    </section>
  );
};
</file>

<file path="frontend/src/components/MultiVendorMatrix.tsx">
import React, { useEffect, useRef, useState } from 'react';
import { useComparisonStore } from '../store/useComparisonStore';
import { apiClient } from '../services/apiClient';
import { ComparisonItemCell, VendorProductResponse } from '../types/api';
import {
  Check,
  Edit3,
  Loader2,
  X,
  AlertTriangle,
  ShoppingBag,
  Truck,
  Ban,
} from 'lucide-react';

export const MultiVendorMatrix: React.FC = () => {
  const { currentMatrix, lockedBudget, applyMatrixOverride } = useComparisonStore();

  const [overrideCell, setOverrideCell] = useState<{
    cell: ComparisonItemCell;
    itemId: string;
    requestedTerm: string;
    reqDiameter: number | null;
  } | null>(null);
  const [vendorProducts, setVendorProducts] = useState<VendorProductResponse[]>([]);
  const [loadingProducts, setLoadingProducts] = useState(false);
  const [savingOverride, setSavingOverride] = useState(false);
  const [overrideError, setOverrideError] = useState<string | null>(null);

  // Selección en Drawer
  const [selectedProductId, setSelectedProductId] = useState<string | null>(null);
  const [forceOverride, setForceOverride] = useState(false);

  const dialogRef = useRef<HTMLDialogElement | null>(null);

  useEffect(() => {
    if (overrideCell && dialogRef.current) {
      if (!dialogRef.current.open) {
        dialogRef.current.showModal();
      }
    } else if (!overrideCell && dialogRef.current?.open) {
      dialogRef.current.close();
    }
  }, [overrideCell]);

  if (!currentMatrix) return null;

  const isLocked = !!lockedBudget;

  const handleOpenOverride = async (
    cell: ComparisonItemCell,
    itemId: string,
    requestedTerm: string,
    reqDiameter: number | null
  ) => {
    if (isLocked) return;
    setOverrideCell({ cell, itemId, requestedTerm, reqDiameter });
    setSelectedProductId(null);
    setForceOverride(false);
    setOverrideError(null);

    try {
      setLoadingProducts(true);
      const prods = await apiClient.getVendorProducts(cell.vendor_id);
      setVendorProducts(prods);
      setLoadingProducts(false);
    } catch (err: unknown) {
      setLoadingProducts(false);
      setOverrideError(err instanceof Error ? err.message : 'Error al cargar productos del comercio');
    }
  };

  const handleCloseDrawer = () => {
    setOverrideCell(null);
    setSelectedProductId(null);
    setForceOverride(false);
    setOverrideError(null);
  };

  const handleConfirmOverride = async () => {
    if (!overrideCell || !selectedProductId) return;

    try {
      setSavingOverride(true);
      setOverrideError(null);
      const targetMatchId = overrideCell.cell.match_id;
      if (!targetMatchId) {
        throw new Error('No se encontró el identificador de coincidencia para esta celda.');
      }

      await applyMatrixOverride(currentMatrix.run_id, targetMatchId, {
        vendor_product_id: selectedProductId,
        save_vendor_alias: true,
        force_dimension_override: forceOverride,
      });

      handleCloseDrawer();
      setSavingOverride(false);
    } catch (err: unknown) {
      setSavingOverride(false);
      setOverrideError(err instanceof Error ? err.message : 'Error al sustituir producto');
    }
  };

  const selectedProduct = vendorProducts.find((p) => p.id === selectedProductId);
  const hasDimensionMismatch =
    !!selectedProduct &&
    overrideCell?.reqDiameter != null &&
    selectedProduct.diameter_mm != null &&
    Math.abs(selectedProduct.diameter_mm - (overrideCell?.reqDiameter || 0)) > 0.5;

  return (
    <section
      role="region"
      aria-labelledby="matrix-heading"
      className="bg-surface-elevated border border-surface-hairline rounded-container p-4 sm:p-5 transition-colors space-y-4"
    >
      <div className="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-surface-hairline gap-2">
        <div>
          <div className="flex items-center gap-2">
            <span className="font-mono text-xs font-bold px-2 py-0.5 rounded-control bg-surface-subtle text-action-primary border border-surface-hairline">
              PASO 03
            </span>
            <h2 id="matrix-heading" className="text-sm sm:text-base font-display font-bold text-content-primary">
              Matriz Comparativa Multi-Corralón
            </h2>
          </div>
          <p className="text-xs text-content-secondary mt-1">
            Filtro dimensional duro en tiempo real. Los recuadros resaltados identifican la oferta más económica por línea.
          </p>
        </div>
      </div>

      {/* Tabla con Primera Columna Sticky y Protección de Foco Oculto */}
      <div
        tabIndex={0}
        role="region"
        aria-label="Tabla de matriz comparativa con desplazamiento horizontal"
        className="overflow-x-auto border border-surface-hairline rounded-control bg-surface-canvas matrix-scroll-container focus:outline-none"
      >
        <table role="grid" className="w-full text-left text-xs border-collapse">
          <thead>
            <tr className="border-b border-surface-hairline bg-surface-subtle text-content-secondary uppercase text-[11px] font-semibold tracking-wider">
              {/* Columna Sticky de Especificación Técnica */}
              <th
                scope="col"
                className="py-3 px-3.5 min-w-[260px] sticky left-0 z-20 bg-surface-elevated border-r border-surface-hairline shadow-[2px_0_4px_rgba(0,0,0,0.04)]"
              >
                Material Requerido en Obra
              </th>
              <th scope="col" className="py-3 px-2 text-center min-w-[70px]">
                Cant.
              </th>
              {currentMatrix.vendors.map((v) => (
                <th key={v.vendor_id} scope="col" className="py-3 px-3 text-right min-w-[210px] border-l border-surface-hairline">
                  <div className="font-bold text-content-primary truncate">{v.vendor_name}</div>
                  <div className="text-[10px] text-content-muted font-mono font-normal mt-0.5">
                    {v.locality} · Cob: <span className="tabular-nums font-bold text-content-secondary">{v.coverage_pct}%</span>
                  </div>
                  {/* Barra compacta de cobertura */}
                  <div className="w-full bg-surface-subtle h-1 rounded-full mt-1.5 overflow-hidden">
                    <div
                      className="bg-emerald-600 dark:bg-emerald-500 h-full rounded-full transition-all"
                      style={{ width: `${v.coverage_pct}%` }}
                    />
                  </div>
                </th>
              ))}
            </tr>
          </thead>
          <tbody className="divide-y divide-surface-hairline font-mono">
            {currentMatrix.matrix_rows.map((row) => (
              <tr key={row.requisition_item_id} className="hover:bg-surface-subtle/30 transition-colors">
                {/* Columna Sticky Izquierda */}
                <td className="py-3 px-3.5 font-sans sticky left-0 z-10 bg-surface-elevated border-r border-surface-hairline shadow-[2px_0_4px_rgba(0,0,0,0.04)]">
                  <div className="font-bold text-content-primary text-xs">{row.requested_term}</div>
                  <div className="text-[11px] text-content-secondary flex flex-wrap items-center gap-1.5 mt-1 font-mono">
                    {row.diameter_mm && (
                      <span className="px-1.5 py-0.2 rounded bg-surface-subtle border border-surface-hairline text-[10px]">
                        Ø {row.diameter_mm} mm
                      </span>
                    )}
                    {row.material_type && (
                      <span className="px-1.5 py-0.2 rounded bg-surface-subtle border border-surface-hairline text-[10px] font-sans font-medium">
                        {row.material_type}
                      </span>
                    )}
                  </div>
                </td>

                <td className="py-3 px-2 text-center tabular-nums text-content-primary font-bold">
                  {row.quantity} <span className="text-[10px] text-content-muted font-sans">{row.requested_unit}</span>
                </td>

                {row.vendor_cells.map((cell) => {
                  const isNotCarried = cell.match_status === 'NOT_CARRIED';
                  const isOutOfStock = cell.match_status === 'OUT_OF_STOCK';
                  const isBest = cell.is_best_price;
                  const isSplitWinner = cell.is_selected_split;

                  return (
                    <td
                      key={cell.vendor_id}
                      className={`py-3 px-3 text-right border-l border-surface-hairline transition-colors ${
                        isBest
                          ? 'bg-semantic-winnerBg text-semantic-winnerText'
                          : isNotCarried
                          ? 'bg-not-carried-pattern'
                          : ''
                      }`}
                    >
                      {isNotCarried ? (
                        <div className="inline-flex flex-col items-end">
                          <span className="inline-flex items-center gap-1 text-[10px] font-sans px-2 py-0.5 rounded-control bg-surface-elevated text-content-secondary border border-surface-hairline font-bold shadow-2xs">
                            <Ban className="w-3 h-3 text-action-danger" />
                            [NO TRABAJA MEDIDA]
                          </span>
                          <span className="text-[9px] text-content-muted font-sans mt-0.5">
                            Filtro dimensional duro
                          </span>
                        </div>
                      ) : isOutOfStock ? (
                        <div className="inline-flex flex-col items-end">
                          <span className="text-[10px] font-sans px-2 py-0.5 rounded-control bg-semantic-hitlBg text-semantic-hitlText border border-semantic-hitlBorder font-bold">
                            [SIN STOCK EN CORRALÓN]
                          </span>
                        </div>
                      ) : cell.line_subtotal_ars !== null && cell.line_subtotal_ars !== undefined ? (
                        <div className="group relative">
                          <div
                            className={`font-mono font-bold text-sm tabular-nums ${
                              isBest ? 'text-emerald-700 dark:text-emerald-400' : 'text-content-primary'
                            }`}
                          >
                            $ {cell.line_subtotal_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
                          </div>
                          <div className="text-[10px] text-content-muted tabular-nums mt-0.5">
                            $ {cell.unit_price_ars?.toLocaleString('es-AR', { minimumFractionDigits: 2 })} / {row.requested_unit}
                          </div>

                          <div className="flex items-center justify-end gap-1.5 mt-1">
                            {isBest && (
                              <span className="inline-flex items-center gap-0.5 text-[9px] font-sans px-1.5 py-0.2 rounded bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 font-bold uppercase">
                                <Check className="w-2.5 h-2.5" /> Mejor
                              </span>
                            )}
                            {isSplitWinner && (
                              <span className="inline-flex items-center gap-0.5 text-[9px] font-sans px-1.5 py-0.2 rounded bg-action-primary/10 text-action-primary font-bold uppercase">
                                <ShoppingBag className="w-2.5 h-2.5" /> Split
                              </span>
                            )}
                            {!isLocked && (
                              <button
                                onClick={() =>
                                  handleOpenOverride(cell, row.requisition_item_id, row.requested_term, row.diameter_mm ?? null)
                                }
                                type="button"
                                className="opacity-0 group-hover:opacity-100 focus:opacity-100 transition inline-flex items-center gap-1 text-[10px] font-sans text-content-secondary hover:text-action-primary underline underline-offset-2 ml-1"
                                title="Cambiar producto asignado"
                              >
                                <Edit3 className="w-2.5 h-2.5" /> Cambiar
                              </button>
                            )}
                          </div>
                        </div>
                      ) : (
                        <span className="text-content-muted">-</span>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>

          {/* Pie de Tabla con Totales y Fletes por Corralón */}
          <tfoot className="border-t-2 border-surface-hairline bg-surface-subtle font-mono text-xs">
            <tr>
              <th scope="row" className="py-2.5 px-3.5 sticky left-0 z-20 bg-surface-subtle font-sans text-content-primary font-bold border-r border-surface-hairline">
                Flete Estimado por Envío
              </th>
              <td className="text-center font-bold text-content-muted">-</td>
              {currentMatrix.vendors.map((v) => (
                <td key={v.vendor_id} className="py-2.5 px-3 text-right tabular-nums text-content-secondary border-l border-surface-hairline">
                  <span className="inline-flex items-center gap-1">
                    <Truck className="w-3 h-3 text-content-muted" />
                    + $ {v.delivery_fee_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
                  </span>
                </td>
              ))}
            </tr>
            <tr className="border-t border-surface-hairline font-bold">
              <th scope="row" className="py-3 px-3.5 sticky left-0 z-20 bg-surface-subtle font-sans text-content-primary font-bold border-r border-surface-hairline">
                Costo Total con Flete
              </th>
              <td className="text-center font-bold text-content-muted">-</td>
              {currentMatrix.vendors.map((v) => (
                <td key={v.vendor_id} className="py-3 px-3 text-right tabular-nums text-sm text-content-primary border-l border-surface-hairline font-extrabold">
                  $ {v.total_with_delivery_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
                </td>
              ))}
            </tr>
          </tfoot>
        </table>
      </div>

      {/* Inspector Lateral (Drawer) para Sustitución Manual de Producto con <dialog> Nativo */}
      <dialog
        ref={dialogRef}
        aria-labelledby="override-drawer-title"
        onClose={handleCloseDrawer}
        className="fixed inset-y-0 right-0 m-0 ml-auto h-full max-h-screen w-full max-w-md bg-surface-elevated border-l border-surface-hairline p-0 text-content-primary shadow-2xl backdrop:bg-black/50 backdrop:backdrop-blur-xs focus:outline-none"
      >
        {overrideCell && (
          <div className="flex flex-col h-full">
            {/* Cabecera del Drawer */}
            <div className="p-4 border-b border-surface-hairline flex items-center justify-between bg-surface-subtle">
              <div>
                <span className="text-[10px] font-mono uppercase text-content-muted">
                  Reemplazo Manual de Producto
                </span>
                <h3 id="override-drawer-title" className="text-sm font-bold text-content-primary mt-0.5">
                  {overrideCell.cell.vendor_name}
                </h3>
              </div>
              <button
                onClick={handleCloseDrawer}
                type="button"
                className="p-1 rounded-control hover:bg-surface-elevated text-content-secondary hover:text-content-primary transition"
                aria-label="Cerrar inspector de producto"
              >
                <X className="w-4 h-4" />
              </button>
            </div>

            {/* Contexto del Ítem Solicitado */}
            <div className="p-4 bg-surface-canvas border-b border-surface-hairline text-xs space-y-1">
              <div className="text-content-muted">Ítem solicitado en el pliego:</div>
              <div className="font-bold text-content-primary text-sm font-sans">{overrideCell.requestedTerm}</div>
              {overrideCell.reqDiameter && (
                <div className="text-[11px] font-mono text-content-secondary">
                  Diámetro requerido: <strong>Ø {overrideCell.reqDiameter} mm</strong>
                </div>
              )}
            </div>

            {overrideError && (
              <div className="m-4 p-3 rounded-control bg-action-danger/10 border border-action-danger/30 text-xs text-action-danger font-medium flex items-start gap-2">
                <AlertTriangle className="w-4 h-4 shrink-0 mt-0.5" />
                <span>{overrideError}</span>
              </div>
            )}

            {/* Lista de Productos del Proveedor */}
            <div className="flex-1 overflow-y-auto p-4 space-y-2">
              <span className="text-[11px] font-semibold uppercase text-content-secondary tracking-wider block mb-2">
                Catálogo Activo del Comercio ({vendorProducts.length} ítems):
              </span>

              {loadingProducts ? (
                <div className="py-12 text-center text-content-secondary text-xs flex items-center justify-center gap-2">
                  <Loader2 className="w-4 h-4 animate-spin text-action-primary" />
                  <span>Cargando catálogo del corralón...</span>
                </div>
              ) : vendorProducts.length === 0 ? (
                <div className="py-8 text-center text-xs text-content-muted">
                  No hay productos cargados para este comercio.
                </div>
              ) : (
                vendorProducts.map((p) => {
                  const isSelected = selectedProductId === p.id;
                  const isCurrentAssigned = overrideCell.cell.vendor_product_id === p.id;

                  return (
                    <button
                      key={p.id}
                      onClick={() => {
                        setSelectedProductId(p.id);
                        setForceOverride(false);
                      }}
                      type="button"
                      className={`w-full text-left p-3 rounded-control border text-xs transition flex items-start justify-between gap-3 ${
                        isSelected
                          ? 'border-action-primary bg-action-primary/5 shadow-xs'
                          : 'border-surface-hairline bg-surface-canvas hover:border-surface-strong'
                      }`}
                    >
                      <div className="space-y-1">
                        <div className="font-bold text-content-primary font-sans">{p.raw_description}</div>
                        <div className="text-[11px] text-content-muted font-mono flex items-center gap-2">
                          <span>SKU: {p.sku}</span>
                          {p.diameter_mm && <span>Ø {p.diameter_mm} mm</span>}
                          {p.brand && <span>{p.brand}</span>}
                        </div>
                        {isCurrentAssigned && (
                          <span className="inline-block px-1.5 py-0.2 rounded-control bg-surface-subtle border border-surface-hairline text-[10px] text-content-secondary font-sans font-semibold">
                            (Actualmente emparejado)
                          </span>
                        )}
                      </div>
                      <div className="text-right font-mono font-bold text-content-primary tabular-nums">
                        $ {p.price_cash_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
                      </div>
                    </button>
                  );
                })
              )}
            </div>

            {/* Alerta de Discrepancia Dimensional y Confirmación */}
            {hasDimensionMismatch && (
              <div className="p-4 bg-semantic-hitlBg border-t border-semantic-hitlBorder text-xs text-semantic-hitlText space-y-2">
                <div className="flex items-start gap-2 font-bold">
                  <AlertTriangle className="w-4 h-4 shrink-0 mt-0.5 text-amber-700 dark:text-amber-400" />
                  <span>Discrepancia Dimensional Física Detectada</span>
                </div>
                <p className="text-[11px] leading-relaxed">
                  El pliego solicita <strong>Ø {overrideCell.reqDiameter} mm</strong> y el producto seleccionado posee <strong>Ø {selectedProduct?.diameter_mm} mm</strong>. Esta acción vulnera la correspondencia física directa.
                </p>
                <label className="flex items-center gap-2 pt-1 font-semibold cursor-pointer select-none">
                  <input
                    type="checkbox"
                    checked={forceOverride}
                    onChange={(e) => setForceOverride(e.target.checked)}
                    className="rounded-control border-surface-strong text-action-primary focus:ring-action-focus w-4 h-4"
                  />
                  <span>Forzar sustitución dimensional bajo mi responsabilidad técnica</span>
                </label>
              </div>
            )}

            {/* Pie del Drawer con Acciones */}
            <div className="p-4 border-t border-surface-hairline bg-surface-subtle flex items-center justify-end gap-2">
              <button
                onClick={handleCloseDrawer}
                type="button"
                className="px-3.5 py-2 rounded-control border border-surface-hairline bg-surface-elevated text-content-secondary hover:text-content-primary text-xs font-semibold transition"
              >
                Cancelar
              </button>
              <button
                onClick={handleConfirmOverride}
                disabled={savingOverride || !selectedProductId || (hasDimensionMismatch && !forceOverride)}
                type="button"
                className="inline-flex items-center gap-2 px-4 py-2 rounded-control bg-action-primary hover:bg-action-hover disabled:opacity-50 text-white font-bold text-xs shadow-sm transition min-h-[38px]"
              >
                {savingOverride ? (
                  <>
                    <Loader2 className="w-3.5 h-3.5 animate-spin" />
                    <span>Guardando sustitución...</span>
                  </>
                ) : (
                  <span>Confirmar Sustitución</span>
                )}
              </button>
            </div>
          </div>
        )}
      </dialog>
    </section>
  );
};
</file>

<file path="frontend/src/components/SplitCartOptimizerCard.tsx">
import React, { useState } from 'react';
import { useComparisonStore } from '../store/useComparisonStore';
import { useWorkspaceStore } from '../store/useWorkspaceStore';
import { apiClient } from '../services/apiClient';
import {
  Lock,
  Download,
  FileText,
  DollarSign,
  Truck,
  Check,
  Copy,
  ShieldCheck,
  TrendingDown,
} from 'lucide-react';
import { PaymentModality } from '../types/api';

interface SplitCartOptimizerCardProps {
  onLockBudget: () => void;
}

export const SplitCartOptimizerCard: React.FC<SplitCartOptimizerCardProps> = ({ onLockBudget }) => {
  const { role } = useWorkspaceStore();
  const {
    currentMatrix,
    lockedBudget,
    lockBudget,
    isLoading,
    paymentModality,
    includeDeliveryFees,
    markupPct,
    setPaymentModality,
    setIncludeDeliveryFees,
    setMarkupPct,
  } = useComparisonStore();

  const [copiedLink, setCopiedLink] = useState(false);

  if (!currentMatrix) {
    return (
      <div className="bg-surface-elevated border border-surface-hairline rounded-container p-4 sm:p-5 transition-colors space-y-3">
        <div className="flex items-center gap-2 pb-2 border-b border-surface-hairline">
          <span className="font-mono text-xs font-bold px-2 py-0.5 rounded-control bg-surface-subtle text-action-primary border border-surface-hairline">
            FINANZAS
          </span>
          <h2 className="text-sm font-display font-bold text-content-primary">
            Optimizador Logístico y Financiero
          </h2>
        </div>
        <p className="text-xs text-content-secondary leading-relaxed">
          Configura los parámetros de cotización antes o después de procesar el pliego. Los cálculos se actualizarán automáticamente.
        </p>

        {/* Pre-configuración de Parámetros */}
        <div className="space-y-3 pt-2">
          <div>
            <label className="block text-[11px] font-semibold uppercase text-content-secondary tracking-wider mb-1">
              Modalidad de Pago:
            </label>
            <div className="grid grid-cols-3 gap-1 bg-surface-subtle p-1 rounded-control border border-surface-hairline text-xs font-semibold">
              {(['CASH', 'LIST', 'ACOPIO'] as PaymentModality[]).map((mod) => (
                <button
                  key={mod}
                  type="button"
                  onClick={() => setPaymentModality(mod)}
                  className={`py-1 rounded-control transition ${
                    paymentModality === mod
                      ? 'bg-surface-elevated text-action-primary shadow-xs'
                      : 'text-content-secondary hover:text-content-primary'
                  }`}
                >
                  {mod === 'CASH' ? 'Contado' : mod === 'LIST' ? 'Lista' : 'Acopio'}
                </button>
              ))}
            </div>
          </div>

          <label className="flex items-center gap-2 text-xs font-semibold text-content-primary cursor-pointer select-none">
            <input
              type="checkbox"
              checked={includeDeliveryFees}
              onChange={(e) => setIncludeDeliveryFees(e.target.checked)}
              className="rounded-control border-surface-strong text-action-primary focus:ring-action-focus w-4 h-4"
            />
            <Truck className="w-4 h-4 text-content-muted" />
            <span>Incluir fletes logísticos en el cómputo</span>
          </label>
        </div>
      </div>
    );
  }

  const bestSingle = {
    name: currentMatrix.best_single_vendor_name || 'Comercio Único',
    total: currentMatrix.best_single_total_ars || 0,
  };

  const split = currentMatrix.split_cart;
  const isRecommended = split.is_split_recommended;
  const isLocked = !!lockedBudget;

  const handleLock = async () => {
    await lockBudget();
    onLockBudget();
  };

  const handleCopyShareLink = () => {
    const shareUrl = `${window.location.origin}/p/${currentMatrix.public_share_token}`;
    navigator.clipboard.writeText(shareUrl);
    setCopiedLink(true);
    setTimeout(() => setCopiedLink(false), 2500);
  };

  const adjustMarkup = (delta: number) => {
    const next = Math.max(0, Math.min(100, Math.round((markupPct + delta) * 10) / 10));
    setMarkupPct(next);
  };

  return (
    <div className="bg-surface-elevated border border-surface-hairline rounded-container p-4 sm:p-5 transition-colors space-y-4">
      {/* Cabecera del Panel Financiero */}
      <div className="flex items-center justify-between pb-3 border-b border-surface-hairline">
        <div className="flex items-center gap-2">
          <span className="font-mono text-xs font-bold px-2 py-0.5 rounded-control bg-surface-subtle text-action-primary border border-surface-hairline">
            DECISIÓN
          </span>
          <h2 className="text-sm font-display font-bold text-content-primary">
            Optimizador Logístico: Split Cart
          </h2>
        </div>
        {isLocked && (
          <span className="inline-flex items-center gap-1 text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded-control bg-semantic-winnerBg text-semantic-winnerText border border-surface-hairline">
            <Lock className="w-3 h-3" /> Congelado
          </span>
        )}
      </div>

      {/* Controles Financieros Adherentes */}
      <div className="bg-surface-subtle p-3 rounded-control border border-surface-hairline space-y-3 text-xs">
        {/* Selector de Modalidad */}
        <div>
          <span className="block text-[10px] font-semibold uppercase text-content-muted tracking-wider mb-1">
            Modalidad Comercial:
          </span>
          <div className="grid grid-cols-3 gap-1 bg-surface-elevated p-1 rounded-control border border-surface-hairline text-xs font-semibold">
            {(['CASH', 'LIST', 'ACOPIO'] as PaymentModality[]).map((mod) => (
              <button
                key={mod}
                type="button"
                disabled={isLocked}
                onClick={() => setPaymentModality(mod)}
                className={`py-1 rounded-control transition ${
                  paymentModality === mod
                    ? 'bg-action-primary text-white shadow-xs'
                    : 'text-content-secondary hover:text-content-primary'
                }`}
              >
                {mod === 'CASH' ? 'Contado' : mod === 'LIST' ? 'Precio Lista' : 'Acopio'}
              </button>
            ))}
          </div>
        </div>

        {/* Switch de Fletes */}
        <label className="flex items-center justify-between cursor-pointer select-none">
          <span className="text-content-primary font-semibold flex items-center gap-1.5">
            <Truck className="w-4 h-4 text-content-muted" />
            <span>Fletes por corralón</span>
          </span>
          <input
            type="checkbox"
            disabled={isLocked}
            checked={includeDeliveryFees}
            onChange={(e) => setIncludeDeliveryFees(e.target.checked)}
            className="rounded-control border-surface-strong text-action-primary focus:ring-action-focus w-4 h-4"
          />
        </label>

        {/* Margen del Presupuestador (ESTIMATOR) con Alternativa Accesible a Sliders (WCAG 2.5.7) */}
        {role === 'ESTIMATOR' && (
          <div className="pt-2 border-t border-surface-hairline/80">
            <div className="flex items-center justify-between mb-1.5">
              <span className="font-semibold text-content-primary flex items-center gap-1">
                <DollarSign className="w-3.5 h-3.5 text-action-primary" />
                <span>Margen Honorarios:</span>
              </span>
              <span className="font-mono font-bold text-content-primary tabular-nums text-xs">
                {markupPct.toFixed(1)} %
              </span>
            </div>
            <div className="flex items-center gap-1.5">
              <button
                type="button"
                disabled={isLocked || markupPct <= 0}
                onClick={() => adjustMarkup(-5)}
                className="px-2 py-1 rounded-control bg-surface-elevated hover:bg-surface-subtle border border-surface-hairline text-content-primary text-xs font-mono font-bold min-h-[32px] min-w-[36px]"
                title="Restar 5%"
              >
                -5%
              </button>
              <button
                type="button"
                disabled={isLocked || markupPct <= 0}
                onClick={() => adjustMarkup(-1)}
                className="px-2 py-1 rounded-control bg-surface-elevated hover:bg-surface-subtle border border-surface-hairline text-content-primary text-xs font-mono font-bold min-h-[32px] min-w-[36px]"
                title="Restar 1%"
              >
                -1%
              </button>
              <input
                type="number"
                step="0.5"
                min="0"
                max="100"
                disabled={isLocked}
                value={markupPct}
                onChange={(e) => setMarkupPct(parseFloat(e.target.value) || 0)}
                className="flex-1 bg-surface-elevated border border-surface-hairline rounded-control px-2 py-1 text-xs text-center font-mono font-bold text-content-primary tabular-nums"
                aria-label="Porcentaje de margen profesional"
              />
              <button
                type="button"
                disabled={isLocked || markupPct >= 100}
                onClick={() => adjustMarkup(1)}
                className="px-2 py-1 rounded-control bg-surface-elevated hover:bg-surface-subtle border border-surface-hairline text-content-primary text-xs font-mono font-bold min-h-[32px] min-w-[36px]"
                title="Sumar 1%"
              >
                +1%
              </button>
              <button
                type="button"
                disabled={isLocked || markupPct >= 100}
                onClick={() => adjustMarkup(5)}
                className="px-2 py-1 rounded-control bg-surface-elevated hover:bg-surface-subtle border border-surface-hairline text-content-primary text-xs font-mono font-bold min-h-[32px] min-w-[36px]"
                title="Sumar 5%"
              >
                +5%
              </button>
            </div>
          </div>
        )}
      </div>

      {/* Tarjeta de Decisión: Proveedor Único vs Carrito Dividido */}
      <div className="space-y-3 font-mono">
        {/* Opción A: Proveedor Único */}
        <div
          className={`p-3.5 rounded-control border transition ${
            !isRecommended
              ? 'bg-semantic-winnerBg/40 border-emerald-600/50 shadow-xs'
              : 'bg-surface-subtle border-surface-hairline'
          }`}
        >
          <div className="flex items-center justify-between mb-1">
            <span className="text-[10px] uppercase font-bold text-content-muted font-sans tracking-wide">
              Estrategia A · Compra Unificada
            </span>
            {!isRecommended && (
              <span className="text-[9px] font-sans font-bold uppercase px-1.5 py-0.2 rounded bg-semantic-winnerBg text-semantic-winnerText border border-surface-hairline">
                Recomendada
              </span>
            )}
          </div>
          <div className="font-sans font-bold text-xs text-content-primary truncate">{bestSingle.name}</div>
          <div className="text-[11px] text-content-secondary mt-0.5 font-sans">
            1 solo flete logístico consolidado en obra.
          </div>
          <div className="mt-2 pt-2 border-t border-surface-hairline flex items-baseline justify-between">
            <span className="text-[11px] text-content-muted font-sans">Total Obra:</span>
            <span className="text-base font-extrabold text-content-primary tabular-nums">
              $ {bestSingle.total.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
            </span>
          </div>
        </div>

        {/* Opción B: Carrito Dividido Óptimo (Split Cart) */}
        <div
          className={`p-3.5 rounded-control border transition ${
            isRecommended
              ? 'bg-semantic-winnerBg/70 border-emerald-600 shadow-sm'
              : 'bg-surface-subtle border-surface-hairline'
          }`}
        >
          <div className="flex items-center justify-between mb-1">
            <span className="text-[10px] uppercase font-bold text-content-muted font-sans tracking-wide">
              Estrategia B · Split Cart Óptimo
            </span>
            {isRecommended && (
              <span className="text-[9px] font-sans font-extrabold uppercase px-1.5 py-0.2 rounded bg-action-primary text-white">
                Mayor Ahorro Neto
              </span>
            )}
          </div>
          <div className="font-sans font-bold text-xs text-content-primary">
            {split.participating_vendors_count} Corralones Seleccionados
          </div>
          <div className="text-[10px] text-content-secondary mt-0.5 font-sans truncate">
            {split.participating_vendor_names.join(' + ')}
          </div>

          <div className="mt-2 pt-2 border-t border-surface-hairline space-y-1 text-xs">
            <div className="flex justify-between text-content-secondary text-[11px]">
              <span className="font-sans">Materiales:</span>
              <span className="tabular-nums">
                $ {split.total_materials_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
              </span>
            </div>
            <div className="flex justify-between text-content-secondary text-[11px]">
              <span className="font-sans">Suma Fletes ({split.participating_vendors_count} viajes):</span>
              <span className="tabular-nums font-semibold text-amber-700 dark:text-amber-400">
                + $ {split.total_delivery_fees_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
              </span>
            </div>
            <div className="flex justify-between text-content-primary font-bold pt-1 border-t border-surface-hairline items-baseline">
              <span className="font-sans">Total Split Cart:</span>
              <span className="text-base font-extrabold text-emerald-700 dark:text-emerald-400 tabular-nums">
                $ {split.total_cart_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
              </span>
            </div>
          </div>

          {split.savings_vs_single_vendor_ars > 0 && (
            <div className="mt-2.5 p-2 rounded-control bg-semantic-winnerBg text-semantic-winnerText border border-surface-hairline text-xs font-semibold flex items-center justify-between font-sans">
              <span className="flex items-center gap-1 text-[11px]">
                <TrendingDown className="w-3.5 h-3.5" /> Ahorro Neto Real:
              </span>
              <span className="font-mono font-extrabold tabular-nums">
                -$ {split.savings_vs_single_vendor_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
              </span>
            </div>
          )}
        </div>
      </div>

      {/* Acciones de Cierre, Congelamiento e Inmutabilidad */}
      <div className="pt-2 border-t border-surface-hairline space-y-2.5">
        {!isLocked ? (
          <button
            onClick={handleLock}
            disabled={isLoading}
            type="button"
            className="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-control bg-action-primary hover:bg-action-hover text-white font-bold text-xs shadow-sm transition min-h-[42px]"
          >
            <Lock className="w-3.5 h-3.5" />
            <span>Congelar Presupuesto Definitivo (Lock-Budget)</span>
          </button>
        ) : (
          <div className="space-y-2">
            <div className="p-2.5 rounded-control bg-surface-subtle border border-surface-hairline text-[11px] text-content-secondary space-y-1">
              <div className="flex items-center gap-1.5 font-bold text-content-primary font-mono text-[10px] uppercase">
                <ShieldCheck className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
                <span>Snapshot Inmutable HMAC-SHA256 Verificado</span>
              </div>
              <p className="font-sans leading-tight">
                El pliego ha quedado congelado contra mutaciones. Puedes descargar los documentos y compartir el enlace público.
              </p>
            </div>

            <div className="grid grid-cols-2 gap-2">
              <a
                href={apiClient.getPdfUrl(currentMatrix.run_id, 'comparison')}
                target="_blank"
                rel="noreferrer"
                className="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-control bg-surface-subtle hover:bg-surface-elevated border border-surface-hairline text-content-primary text-xs font-semibold transition"
              >
                <Download className="w-3.5 h-3.5 text-action-primary" />
                <span>PDF Comparativa</span>
              </a>
              <a
                href={apiClient.getPdfUrl(currentMatrix.run_id, 'client_budget')}
                target="_blank"
                rel="noreferrer"
                className="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-control bg-action-primary hover:bg-action-hover text-white text-xs font-bold transition shadow-sm"
              >
                <FileText className="w-3.5 h-3.5" />
                <span>PDF Cliente</span>
              </a>
            </div>

            <button
              onClick={handleCopyShareLink}
              type="button"
              className="w-full inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-control bg-surface-subtle hover:bg-surface-elevated border border-surface-hairline text-xs font-semibold text-content-primary transition"
            >
              {copiedLink ? (
                <>
                  <Check className="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" />
                  <span>¡Enlace Público Copiado al Portapapeles!</span>
                </>
              ) : (
                <>
                  <Copy className="w-3.5 h-3.5" />
                  <span>Copiar Enlace Público (/p/{currentMatrix.public_share_token.slice(0, 8)}...)</span>
                </>
              )}
            </button>
          </div>
        )}
      </div>
    </div>
  );
};
