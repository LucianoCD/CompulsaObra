<file path="frontend/src/components/MultiVendorMatrix.tsx">
import React, { useState } from 'react';
import { useComparisonStore } from '../store/useComparisonStore';
import { apiClient } from '../services/apiClient';
import { ComparisonItemCell, VendorProductResponse } from '../types/api';
import { Check, Edit3, Loader2, Sparkles, X } from 'lucide-react';

export const MultiVendorMatrix: React.FC = () => {
  const { currentMatrix, runComparison } = useComparisonStore();

  const [overrideCell, setOverrideCell] = useState<{
    cell: ComparisonItemCell;
    itemId: string;
  } | null>(null);
  const [vendorProducts, setVendorProducts] = useState<VendorProductResponse[]>([]);
  const [loadingProducts, setLoadingProducts] = useState(false);
  const [savingOverride, setSavingOverride] = useState(false);

  if (!currentMatrix) return null;

  const handleOpenOverride = async (cell: ComparisonItemCell, itemId: string) => {
    setOverrideCell({ cell, itemId });
    try {
      setLoadingProducts(true);
      const prods = await apiClient.getVendorProducts(cell.vendor_id);
      setVendorProducts(prods);
      setLoadingProducts(false);
    } catch {
      setLoadingProducts(false);
    }
  };

  const handleSelectOverrideProduct = async (productId: string) => {
    if (!overrideCell) return;
    try {
      setSavingOverride(true);
      // Buscar el match_id correspondiente a esta celda
      // Por simplicidad, recargamos la compulsa tras registrar el alias o match
      await apiClient.overrideMatch(currentMatrix.run_id, currentMatrix.run_id, {
        vendor_product_id: productId,
        save_vendor_alias: true,
        force_dimension_override: false,
      });
      await runComparison(currentMatrix.requisition_id);
      setOverrideCell(null);
      setSavingOverride(false);
    } catch {
      setSavingOverride(false);
      setOverrideCell(null);
    }
  };

  return (
    <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg space-y-4">
      <div className="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-slate-800 gap-2">
        <div>
          <h2 className="text-base font-semibold text-slate-100 flex items-center gap-2">
            <Sparkles className="w-4 h-4 text-emerald-400" />
            Matriz Comparativa Multi-Comercio
          </h2>
          <p className="text-xs text-slate-400">
            Comparación renglón por renglón con filtro dimensional duro. Los precios en verde indican la oferta ganadora por línea.
          </p>
        </div>
      </div>

      <div className="overflow-x-auto">
        <table className="w-full text-left text-xs">
          <thead>
            <tr className="border-b border-slate-800 text-slate-400 uppercase tracking-wider text-[11px]">
              <th className="py-2.5 px-3 min-w-[200px]">Material Solicitado</th>
              <th className="py-2.5 px-2 text-center">Cant.</th>
              {currentMatrix.vendors.map((v) => (
                <th key={v.vendor_id} className="py-2.5 px-3 text-right min-w-[170px]">
                  <div className="font-semibold text-slate-200">{v.vendor_name}</div>
                  <div className="text-[10px] text-slate-400 font-normal">
                    {v.locality} — Cobertura: {v.coverage_pct}%
                  </div>
                </th>
              ))}
            </tr>
          </thead>
          <tbody className="divide-y divide-slate-800/60 font-mono">
            {currentMatrix.matrix_rows.map((row) => (
              <tr key={row.requisition_item_id} className="hover:bg-slate-800/20 transition">
                <td className="py-3 px-3 font-sans">
                  <div className="font-semibold text-slate-200">{row.requested_term}</div>
                  <div className="text-[11px] text-slate-400 flex items-center gap-2 mt-0.5">
                    {row.diameter_mm ? <span>Ø {row.diameter_mm} mm</span> : null}
                    {row.material_type ? <span>{row.material_type}</span> : null}
                  </div>
                </td>
                <td className="py-3 px-2 text-center tabular-nums text-slate-300">
                  {row.quantity} {row.requested_unit}
                </td>

                {row.vendor_cells.map((cell) => {
                  const isNotCarried = cell.match_status === 'NOT_CARRIED';
                  const isOutOfStock = cell.match_status === 'OUT_OF_STOCK';
                  const isBest = cell.is_best_price;

                  return (
                    <td
                      key={cell.vendor_id}
                      className={`py-3 px-3 text-right transition ${
                        isBest
                          ? 'bg-emerald-500/10 border-l border-r border-emerald-500/20'
                          : ''
                      }`}
                    >
                      {isNotCarried ? (
                        <div className="inline-flex flex-col items-end">
                          <span className="text-[10px] font-sans px-1.5 py-0.5 rounded bg-red-500/10 text-red-400 border border-red-500/20 font-medium">
                            No Trabaja Medida
                          </span>
                          <span className="text-[9px] text-slate-500 font-sans mt-0.5">
                            Filtro dimensional duro
                          </span>
                        </div>
                      ) : isOutOfStock ? (
                        <div className="inline-flex flex-col items-end">
                          <span className="text-[10px] font-sans px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 font-medium">
                            Sin Stock
                          </span>
                        </div>
                      ) : cell.line_subtotal_ars !== null && cell.line_subtotal_ars !== undefined ? (
                        <div className="group relative">
                          <div
                            className={`font-semibold tabular-nums text-sm ${
                              isBest ? 'text-emerald-400' : 'text-slate-200'
                            }`}
                          >
                            $ {cell.line_subtotal_ars.toLocaleString('es-AR', { minimumFractionDigits: 2 })}
                          </div>
                          <div className="text-[10px] text-slate-400 tabular-nums">
                            $ {cell.unit_price_ars?.toLocaleString('es-AR', { minimumFractionDigits: 2 })} / {row.requested_unit}
                          </div>
                          {isBest && (
                            <span className="inline-flex items-center gap-0.5 text-[9px] font-sans text-emerald-400 font-semibold uppercase mt-0.5">
                              <Check className="w-2.5 h-2.5" /> Mejor Precio
                            </span>
                          )}
                          <button
                            onClick={() => handleOpenOverride(cell, row.requisition_item_id)}
                            className="opacity-0 group-hover:opacity-100 transition inline-flex items-center gap-1 text-[9px] text-slate-400 hover:text-slate-200 mt-0.5 font-sans"
                            title="Cambiar producto"
                          >
                            <Edit3 className="w-2.5 h-2.5" /> Cambiar
                          </button>
                        </div>
                      ) : (
                        <span className="text-slate-600">-</span>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* Modal de reasignación manual de producto */}
      {overrideCell && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/80 backdrop-blur-sm p-4">
          <div className="bg-slate-900 border border-slate-800 rounded-xl w-full max-w-lg p-5 shadow-2xl space-y-4">
            <div className="flex items-center justify-between pb-2 border-b border-slate-800">
              <h3 className="font-semibold text-slate-100 text-sm">
                Sustituir Producto en {overrideCell.cell.vendor_name}
              </h3>
              <button onClick={() => setOverrideCell(null)} className="p-1 rounded hover:bg-slate-800 text-slate-400">
                <X className="w-4 h-4" />
              </button>
            </div>

            {loadingProducts ? (
              <div className="flex items-center justify-center py-8 text-xs text-slate-400 gap-2">
                <Loader2 className="w-4 h-4 animate-spin text-emerald-400" />
                Cargando catálogo del negocio...
              </div>
            ) : (
              <div className="max-h-60 overflow-y-auto space-y-2">
                {vendorProducts.map((p) => (
                  <button
                    key={p.id}
                    onClick={() => handleSelectOverrideProduct(p.id)}
                    disabled={savingOverride}
                    className="w-full text-left p-2.5 rounded-lg bg-slate-950 hover:bg-slate-800 border border-slate-800 flex items-center justify-between transition text-xs"
                  >
                    <div>
                      <div className="font-medium text-slate-200">{p.raw_description}</div>
                      <div className="text-[10px] text-slate-400">
                        SKU: {p.sku} | {p.diameter_mm ? `Ø ${p.diameter_mm} mm` : ''}
                      </div>
                    </div>
                    <div className="text-right font-mono font-semibold text-emerald-400">
                      $ {p.price_cash_ars.toLocaleString('es-AR')}
                    </div>
                  </button>
                ))}
              </div>
            )}
          </div>
        </div>
      )}
    </div>
  );
};
</file>

<file path="frontend/src/components/SplitCartOptimizerCard.tsx">
import React from 'react';
import { useComparisonStore } from '../store/useComparisonStore';
import { ShoppingBag, Lock, Download, FileText } from 'lucide-react';
import { apiClient } from '../services/apiClient';

interface SplitCartOptimizerCardProps {
  onLockBudget: () => void;
}

export const SplitCartOptimizerCard: React.FC<SplitCartOptimizerCardProps> = ({ onLockBudget }) => {
  const { currentMatrix, lockedBudget, lockBudget, isLoading } = useComparisonStore();

  if (!currentMatrix) return null;

  const bestSingle = {
    name: currentMatrix.best_single_vendor_name || 'Comercio Único',
    total: currentMatrix.best_single_total_ars || 0,
  };

  const split = currentMatrix.split_cart;
  const isRecommended = split.is_split_recommended;

  const handleLock = async () => {
    await lockBudget();
    onLockBudget();
  };

  return (
    <div className="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-lg space-y-5">
      <div className="flex items-center justify-between pb-3 border-b border-slate-800">
