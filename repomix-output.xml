"""Dependencias de inyección para autenticación, sesión y workspace_id."""

import uuid
from typing import Optional
from fastapi import Depends, Header, HTTPException, status
from sqlalchemy import select
from sqlalchemy.orm import Session

from app.core.database import get_db
from app.core.security import decode_access_token
from app.models.workspace import Workspace, User
from app.services.seed import seed_demo_data_if_needed


def get_current_workspace(
    db: Session = Depends(get_db),
    authorization: Optional[str] = Header(None),
    x_workspace_id: Optional[str] = Header(None),
) -> Workspace:
    """Resuelve el Workspace activo con arranque automático en Modo Demo."""
    # 1. Si se provee encabezado explícito X-Workspace-Id
    if x_workspace_id:
        try:
            ws_id = uuid.UUID(x_workspace_id)
            ws = db.scalar(select(Workspace).where(Workspace.id == ws_id))
            if ws:
                return ws
        except ValueError:
            pass

    # 2. Si se provee Bearer JWT
    if authorization and authorization.startswith("Bearer "):
        token = authorization.split(" ")[1]
        payload = decode_access_token(token)
        if payload and "workspace_id" in payload:
            ws_id = uuid.UUID(payload["workspace_id"])
            ws = db.scalar(select(Workspace).where(Workspace.id == ws_id))
            if ws:
                return ws

    # 3. Fallback determinista: Workspace Demo Jujuy (arranque inmediato sin fricción)
    demo_ws = seed_demo_data_if_needed(db)
    return demo_ws
