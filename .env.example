# Entorno de ejecución: development | production
ENVIRONMENT=development
PROJECT_NAME=CompulsaObra

# Base de Datos
# Desarrollo local / pruebas:
DATABASE_URL=sqlite:///./compulsaobra.db
# Producción (PostgreSQL 16):
# DATABASE_URL=postgresql+psycopg2://compulsa_user:<PASSWORD_FUERTE>@db:5432/compulsa_obra
# POSTGRES_USER=compulsa_user
# POSTGRES_PASSWORD=<PASSWORD_FUERTE>
# POSTGRES_DB=compulsa_obra

# Rate Limiting compartido entre réplicas (obligatorio en producción)
# REDIS_URL=redis://redis:6379/0
REDIS_URL=

# Seguridad JWT, HMAC y Cookies (Generar claves únicas de >=32 caracteres para producción)
# Ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<GENERAR_CLAVE_JWT_UNICA_>=32_CHARS
HMAC_SHARE_SECRET=<GENERAR_CLAVE_HMAC_INDEPENDIENTE_>=32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# En producción es obligatorio true (solo se permite false en desarrollo/pruebas)
COOKIE_SECURE=false

# Políticas de autenticación y correo de verificación (obligatorio proveedor SMTP real en producción)
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_BACKEND=memory
# En producción: definir SMTP_HOST (p.ej. smtp.resend.com), puerto 587/465, remitente válido y URL HTTPS pública
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=no-reply@compulsaobra.local
FRONTEND_PUBLIC_URL=http://localhost:5174
# Para levantar Mailpit en desarrollo Docker con perfil dev:
# COMPOSE_PROFILES=dev
AUTH_RATE_LIMIT_MAX_REQUESTS=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_SECONDS=300

# Ingesta Multimodal (Google GenAI Gemini 2.5 Flash - Opcional)
GEMINI_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
