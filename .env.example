# Base de Datos (PostgreSQL 16 en producción / SQLite transparente en dev y testing)
DATABASE_URL=sqlite:///./compulsaobra.db
# Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://compulsa_user:compulsa_pass@localhost:5432/compulsa_obra

# Seguridad JWT y HMAC
SECRET_KEY=compulsa_super_secret_jwt_key_2026_noa
HMAC_SHARE_SECRET=compulsa_hmac_share_secret_2026_noa
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ingesta Multimodal (Google GenAI Gemini 2.5 Flash - Opcional, con fallback determinista local)
GEMINI_API_KEY=

# CORS y Dominio
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
ENVIRONMENT=development
PROJECT_NAME=CompulsaObra
